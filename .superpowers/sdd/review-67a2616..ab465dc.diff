diff --git a/AICOP/Projects/Time Master/tests/test_window_tracker.py b/AICOP/Projects/Time Master/tests/test_window_tracker.py new file mode 100644 index 0000000..0de70d3 --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_window_tracker.py	 @@ -0,0 +1,39 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +from tracker.window_tracker import classify_app + + +def test_classify_known(): +    assert classify_app('chrome.exe') == 'Chrome' +    assert classify_app('Code.exe') == 'VS Code' +    assert classify_app('WeChat.exe') == 'WeChat' +    assert classify_app('OUTLOOK.EXE') == 'Outlook' + + +def test_classify_unknown(): +    result = classify_app('some_random_app.exe') +    assert result == 'some_random_app' + + +def test_classify_case_sensitive(): +    assert classify_app('WINWORD.EXE') == 'Word' +    assert classify_app('winword.exe') == 'Word' + + +def test_classify_no_ext(): +    result = classify_app('myapp.exe') +    assert result == 'myapp' + + +if __name__ == '__main__': +    test_classify_known() +    print('test_classify_known PASS') +    test_classify_unknown() +    print('test_classify_unknown PASS') +    test_classify_case_sensitive() +    print('test_classify_case_sensitive PASS') +    test_classify_no_ext() +    print('test_classify_no_ext PASS') +    print('All tests passed!') diff --git a/AICOP/Projects/Time Master/tracker/__init__.py b/AICOP/Projects/Time Master/tracker/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/tracker/window_tracker.py b/AICOP/Projects/Time Master/tracker/window_tracker.py new file mode 100644 index 0000000..02291ed --- /dev/null +++ b/AICOP/Projects/Time Master/tracker/window_tracker.py	 @@ -0,0 +1,159 @@ +import os +import time +from datetime import datetime + +try: +    from PySide6.QtCore import QThread, Signal +except ImportError: +    QThread = object +    Signal = None + + +APP_NAME_MAP = { +    'chrome.exe': 'Chrome', +    'msedge.exe': 'Edge', +    'firefox.exe': 'Firefox', +    'Code.exe': 'VS Code', +    'WeChat.exe': 'WeChat', +    'WeChatWork.exe': 'WeCom', +    'sublime_text.exe': 'Sublime Text', +    'cmd.exe': 'Command Prompt', +    'WindowsTerminal.exe': 'Terminal', +    'explorer.exe': 'File Explorer', +    'OUTLOOK.EXE': 'Outlook', +    'WINWORD.EXE': 'Word', +    'EXCEL.EXE': 'Excel', +    'POWERPNT.EXE': 'PowerPoint', +    'wmplayer.exe': 'Windows Media Player', +    'Spotify.exe': 'Spotify', +    'Obsidian.exe': 'Obsidian', +    'notepad.exe': 'Notepad', +    'notepad++.exe': 'Notepad++', +    'pycharm64.exe': 'PyCharm', +    'idea64.exe': 'IntelliJ IDEA', +    'clion64.exe': 'CLion', +    'goland64.exe': 'GoLand', +    'devenv.exe': 'Visual Studio', +    'typora.exe': 'Typora', +    'Foxmail.exe': 'Foxmail', +    'DingTalk.exe': 'DingTalk', +    'Lark.exe': 'Lark', +    'Slack.exe': 'Slack', +    'Discord.exe': 'Discord', +    'Telegram.exe': 'Telegram', +    'PotPlayer.exe': 'PotPlayer', +    'eclipse.exe': 'Eclipse', +    'AndroidStudio.exe': 'Android Studio', +    'Tableau.exe': 'Tableau', +    'Figma.exe': 'Figma', +    'Photoshop.exe': 'Photoshop', +    'winword.exe': 'Word', +    'excel.exe': 'Excel', +    'powerpnt.exe': 'PowerPoint', +    'outlook.exe': 'Outlook', +} + + +def classify_app(process_name): +    name = os.path.basename(process_name) +    return APP_NAME_MAP.get(name, os.path.splitext(name)[0]) + + +class WindowTracker(QThread): +    active_window_changed = Signal(str, str, str) if Signal else None +    idle_changed = Signal(bool) if Signal else None + +    POLL_INTERVAL = 1.0 +    IDLE_THRESHOLD = 60 + +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._running = False +        self._current_session_id = None +        self._current_pid = None +        self._current_process = None +        self._current_title = None +        self._current_app = None +        self._session_start = None +        self._idle_seconds = 0 +        self._is_idle = False + +    def stop(self): +        self._running = False + +    def run(self): +        self._running = True +        while self._running: +            try: +                self._tick() +            except Exception: +                pass +            time.sleep(self.POLL_INTERVAL) + +    def _tick(self): +        info = self._get_foreground_window_info() +        now = datetime.now() + +        if info is None: +            self._idle_seconds += self.POLL_INTERVAL +            if self._idle_seconds >= self.IDLE_THRESHOLD and not self._is_idle: +                self._is_idle = True +                self.idle_changed.emit(True) +                self._close_current_session(now) +            return + +        self._idle_seconds = 0 +        if self._is_idle: +            self._is_idle = False +            self.idle_changed.emit(False) + +        pid, process_name, window_title, app_name = info + +        if (pid != self._current_pid or +                window_title != self._current_title): +            self._close_current_session(now) +            self._current_pid = pid +            self._current_process = process_name +            self._current_title = window_title +            self._current_app = app_name +            self._session_start = now +            sid = self.db.insert_session( +                process_name, window_title, app_name, +                now, None, 0 +            ) +            self._current_session_id = sid +            self.active_window_changed.emit(process_name, window_title, app_name) +        else: +            if self._current_session_id is not None and self._session_start is not None: +                duration = int((now - self._session_start).total_seconds()) +                self.db.update_session_end(self._current_session_id, now, duration) + +    def _close_current_session(self, now): +        if self._current_session_id is not None and self._session_start is not None: +            duration = int((now - self._session_start).total_seconds()) +            self.db.update_session_end(self._current_session_id, now, duration) +            self._current_session_id = None +            self._session_start = None + +    def _get_foreground_window_info(self): +        try: +            import win32gui +            import win32process +            import psutil +            hwnd = win32gui.GetForegroundWindow() +            if hwnd == 0: +                return None +            _, pid = win32process.GetWindowThreadProcessId(hwnd) +            try: +                proc = psutil.Process(pid) +                process_name = proc.name() +            except (psutil.NoSuchProcess, psutil.AccessDenied): +                process_name = f'pid_{pid}' +            window_title = win32gui.GetWindowText(hwnd) +            if not window_title: +                window_title = process_name +            app_name = classify_app(process_name) +            return (pid, process_name, window_title, app_name) +        except Exception: +            return None
