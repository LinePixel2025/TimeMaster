    ws2 = wb.create_sheet("濮ｅ繑妫╁Ч鍥ㄢ偓?) +        ws2.append(['閺冦儲婀?, '鎼存梻鏁ら崥?, '娴ｈ法鏁ょ粔鎺撴殶']) +        for cell in ws2[1]: +            cell.font = Font(bold=True) +        summaries = self.db.get_daily_summaries( +            monday.isoformat(), today.isoformat() +        ) +        for s in summaries: +            ws2.append([s['d'], s['app_name'], s['total_seconds']]) +        for col in ws2.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws2.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        ws3 = wb.create_sheet("鎼存梻鏁ら幒鎺曨攽") +        ws3.append(['鎼存梻鏁ら崥?, '娴ｈ法鏁ょ粔鎺撴殶']) +        for cell in ws3[1]: +            cell.font = Font(bold=True) +        rank = self.db.get_app_rank() +        for r in rank: +            ws3.append([r['app_name'], r['total_seconds']]) +        for col in ws3.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws3.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        wb.save(path) +``` + +- [ ] **Step 3: Write and run tests** + +Create `tests/test_exporter.py`: + +```python +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +import csv +from datetime import datetime +from data.database import DatabaseManager +from export.exporter import Exporter + + +def test_export_csv(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'test', 'Chrome', now, now, 60) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.csv') +        exporter.export_csv(out_path) +        with open(out_path, encoding='utf-8-sig') as f: +            reader = csv.reader(f) +            rows = list(reader) +        assert len(rows) == 2 + 