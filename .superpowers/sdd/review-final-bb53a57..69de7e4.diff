ow.py`: + +```python +import ctypes +from PySide6.QtWidgets import QMainWindow, QVBoxLayout, QWidget, QPushButton, QHBoxLayout, QFileDialog, QMessageBox, QLabel +from PySide6.QtGui import QFont, QColor, QPalette, QBrush, QLinearGradient, QPainter, QAction +from PySide6.QtCore import Qt, QTimer +from ui.stats_widget import StatsWidget +from ui.app_rank_widget import AppRankWidget +from export.exporter import Exporter + + +DWMWA_USE_IMMERSIVE_DARK_MODE = 20 +DWMWA_SYSTEMBACKDROP_TYPE = 38 +MICA = 2 + + +def apply_mica(hwnd): +    try: +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, +            ctypes.byref(ctypes.c_int(1)), ctypes.sizeof(ctypes.c_int) +        ) +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_SYSTEMBACKDROP_TYPE, +            ctypes.byref(ctypes.c_int(MICA)), ctypes.sizeof(ctypes.c_int) +        ) +    except Exception: +        pass + + +class MainWindow(QMainWindow): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self.setWindowTitle("Time Master") +        self.setMinimumSize(800, 500) +        self.resize(900, 600) +        self.setAttribute(Qt.WA_TranslucentBackground) +        self.setStyleSheet(""" +            QMainWindow { background: transparent; } +            QPushButton { +                background-color: rgba(99, 102, 241, 200); +                color: white; +                border: none; +                border-radius: 8px; +                padding: 8px 20px; +                font-family: 'PingFang SC'; +                font-size: 13px; +            } +            QPushButton:hover { +                background-color: rgba(129, 140, 248, 220); +            } +            QPushButton:pressed { +                background-color: rgba(79, 70, 229, 220); +            } +        """) + +        central = QWidget() +        central.setAttribute(Qt.WA_TranslucentBackground) +        self.setCentralWidget(central) +        layout = QVBoxLayout(central) +        layout.setContentsMargins(20, 20, 20, 20) +        layout.setSpacing(16) + +        self.stats_widget = StatsWidget(db) +        layout.addWidget(self.stats_widget) + +        self.app_rank_widget = AppRankWidget(db) +        layout.addWidget(self.app_rank_widget) + +        btn_layout = QHBoxLayout() +        btn_layout.addStretch() +        export_btn = QPushButton("棣冩憸 鐎电厧鍤拋鏉跨秿") +        export_btn.clicked.connect(self._export) +        btn_layout.addWidget(export_btn) +        refresh_btn = QPushButton("閴?閸掗攱鏌?) +        refresh_btn.clicked.connect(self.refresh_data) +        btn_layout.addWidget(refresh_btn) +        layout.addLayout(btn_layout) + +        self.refresh_timer = QTimer(self) +        self.refresh_timer.setInterval(10000) +        self.refresh_timer.timeout.connect(self.refresh_data) +        self.refresh_timer.start() + +    def showEvent(self, event): +        super().showEvent(event) +        QTimer.singleShot(100, self._apply_effect) + +    def _apply_effect(self): +        hwnd = int(self.winId()) +        apply_mica(hwnd) + +    def refresh_data(self): +        self.stats_widget.refresh() +        self.app_rank_widget.refresh() + +    def _export(self): +        from PySide6.QtWidgets import QInputDialog +        formats = ["CSV (.csv)", "Excel (.xlsx)"] +        fmt, ok = QInputDialog.getItem(self, "鐎电厧鍤弽鐓庣础", "闁瀚ㄧ€电厧鍤弽鐓庣础:", formats, 0, False) +        if not ok: +            return +        path, _ = QFileDialog.getSaveFileName( +            self, "娣囨繂鐡ㄩ弬鍥︽", "", +            f"CSV 閺傚洣娆?(*.csv)" if "CSV" in fmt else "Excel 閺傚洣娆?(*.xlsx)" +        ) +        if not path: +            return +        try: +            exporter = Exporter(self.db) +            if "CSV" in fmt: +                exporter.export_csv(path) +            else: +                exporter.export_excel(path) +            QMessageBox.information(self, "鐎电厧鍤幋鎰", f"鐠佹澘缍嶅鎻掝嚤閸戝搫鍩?\n{path}") +        