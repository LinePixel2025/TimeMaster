ime_str = f"{remain_mins}m" +        painter.setPen(QColor(255, 255, 255, 140)) +        painter.drawText(QRectF(w - 60, 0, 55, h), Qt.AlignRight | Qt.AlignVCenter, time_str) + + +class AppRankWidget(QFrame): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._items = [] +        layout = QVBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(4) + +        title = QLabel("搴旂敤浣跨敤鎺掕 (浠婃棩)") +        title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        title.setStyleSheet("color: rgba(255,255,255,180);") +        layout.addWidget(title) + +        self.list_widget = QWidget() +        self.list_layout = QVBoxLayout(self.list_widget) +        self.list_layout.setContentsMargins(0, 8, 0, 0) +        self.list_layout.setSpacing(2) +        layout.addWidget(self.list_widget) + +    def refresh(self): +        data = self.db.get_app_rank() +        while self.list_layout.count(): +            item = self.list_layout.takeAt(0) +            if item.widget(): +                item.widget().deleteLater() +        max_sec = data[0]['total_seconds'] if data else 1 +        for i, item_data in enumerate(data): +            rank_item = AppRankItem( +                i + 1, item_data['app_name'], +                item_data['total_seconds'], max_sec +            ) +            self.list_layout.addWidget(rank_item) +        self.list_layout.addStretch() +``` + +- [ ] **Step 2: Commit** + +```bash +git add ui/app_rank_widget.py +git commit -m "feat: add app usage ranking list with progress bars" +``` + +--- + +### Task 6: Main window with glass effect + +**Files:** +- Create: `ui/main_window.py` + +**Interfaces:** +- Consumes: `StatsWidget`, `AppRankWidget`, `DatabaseManager` +- Produces: `MainWindow(db: DatabaseManager)` class extending `QMainWindow`: +  - `refresh_data()`: refresh all widgets +  - Mica/Acrylic window background +  - `closeEvent`: hide to tray instead of quitting + +- [ ] **Step 1: Write MainWindow** + +Create `ui/main_window.py`: + +```python +import ctypes +from PySide6.QtWidgets import QMainWindow, QVBoxLayout, QWidget, QPushButton, QHBoxLayout, QFileDialog, QMessageBox, QLabel +from PySide6.QtGui import QFont, QColor, QPalette, QBrush, QLinearGradient, QPainter, QAction +from PySide6.QtCore import Qt, QTimer +from ui.stats_widget import StatsWidget +from ui.app_rank_widget import AppRankWidget +from export.exporter import Exporter + + +DWMWA_USE_IMMERSIVE_DARK_MODE = 20 +DWMWA_SYSTEMBACKDROP_TYPE = 38 +MICA = 2 + + +def apply_mica(hwnd): +    try: +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, +            ctypes.byref(ctypes.c_int(1)), ctypes.sizeof(ctypes.c_int) +        ) +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_SYSTEMBACKDROP_TYPE, +            ctypes.byref(ctypes.c_int(MICA)), ctypes.sizeof(ctypes.c_int) +        ) +    except Exception: +        pass + + +class MainWindow(QMainWindow): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self.setWindowTitle("Time Master") +        self.setMinimumSize(800, 500) +        self.resize(900, 600) +        self.setAttribute(Qt.WA_TranslucentBackground) +        self.setStyleSheet(""" +            QMainWindow { background: transparent; } +            QPushButton { +                background-color: rgba(99, 102, 241, 200); +                color: white; +                border: none; +                border-radius: 8px; +                padding: 8px 20px; +                font-family: 'PingFang SC'; +                font-size: 13px; +            } +            QPushButton:hover { +                background-color: rgba(129, 140, 248, 220); +            } +            QPushButton:pressed { +                background-color: rgba(79, 70, 229, 220); +            } +        """) + +        central = QWidget() +        central.setAttribute(Qt.WA_TranslucentBackground) +        self.setCentralWidget(central) +        layout = QVBoxLayout(central) +        layout.setContentsMargins(20, 20, 20, 20) +        layout.setSpacing(16) + +        self.stats_widget = StatsWidget(db) +        layout.addWidget(self.stats_widget) + +        self.app_rank_widget = AppRankWidget(db) +        layout.addWidget(self.app_rank_widget) + +        btn_layout = QHBoxLayout() +        btn_layout.addStretch() +        export_btn = QPushButton("馃摜 瀵煎嚭璁板綍") +        export_btn.clicked.connect(self._export) +        btn_layout.addWidget(export_btn) +        refresh_btn = QPushButton("鉄?鍒锋柊") +        refresh_btn.clicked.connect(self.refresh_data) +        btn_layout.addWidget(refresh_btn) +        layout.addLayout(btn_layout) + +        self.refresh_timer = QTimer(self) +        self.refresh_timer.setInterval(10000) +        self.refresh_timer.timeout.connect(self.refresh_data) +        self.refresh_timer.start() + +    def showEvent(self, event): +        super().showEvent(event) +        QTimer.singleShot(100, self._apply_effect) + +    def _apply_effect(self): +        hwnd = int(self.winId()) +        apply_mica(hwnd) + +    def refresh_data(self): +        self.stats_widget.refresh() +        self.app_rank_widget.refresh() + +    def _export(self): +        from PySide6.QtWidgets import QInputDialog +        formats = ["CSV (.csv)", "Excel (.xlsx)"] +        fmt, ok = QInputDialog.getItem(self, "瀵煎嚭鏍煎紡", "閫夋嫨瀵煎嚭鏍煎紡:", formats, 0, False) +        if not ok: +            return +        path, _ = QFileDialog.getSaveFileName( +            self, "淇濆瓨鏂囦欢", "", +            f"CSV 鏂囦欢 (*.csv)" if "CSV" in fmt else "Excel 鏂囦欢 (*.xlsx)" +        ) +        if not path: +            return +        try: +            exporter = Exporter(self.db) +            if "CSV" in fmt: +                exporter.export_csv(path) +            else: +                exporter.export_excel(path) +            QMessageBox.information(self, "瀵煎嚭鎴愬姛", f"璁板綍宸插鍑哄埌:\n{path}") +        except Exception as e: +            QMessageBox.critical(self, "瀵煎嚭澶辫触", str(e)) + +    def closeEvent(self, event): +        event.ignore() +        self.hide() +``` + +- [ ] **Step 2: Commit** + +```bash +git add ui/main_window.py +git commit -m "feat: add main window with Mica glass effect, stats and export UI" +``` + +--- + +### Task 7: Export module + +**Files:** +- Create: `export/__init__.py` +- Create: `export/exporter.py` +- Create: `tests/test_exporter.py` + +**Interfaces:** +- Consumes: `DatabaseManager` +- Produces: `Exporter(db: DatabaseManager)` class: +  - `export_csv(path)`: write all sessions to CSV +  - `export_excel(path)`: write sessions, daily summaries, app rankings to Excel + +- [ ] **Step 1: Create export/__init__.py** + +```python +``` + +- [ ] **Step 2: Write Exporter** + +Create `export/exporter.py`: + +```python +import csv +from datetime import date, timedelta + + +class Exporter: +    def __init__(self, db): +        self.db = db + +    def export_csv(self, path): +        sessions = self.db.get_all_sessions() +        with open(path, 'w', newline='', encoding='utf-8-sig') as f: +            writer = csv.writer(f) +            writer.writerow(['杩涚▼鍚?, '绐楀彛鏍囬', '搴旂敤鍚?, '寮€濮嬫椂闂?, '缁撴潫鏃堕棿', '鎸佺画绉掓暟']) +            for s in sessions: +                writer.writerow([ +                    s['process_name'], s['window_title'], s['app_name'], +                    s['start_time'], s['end_time'], s['duration_seconds'] +                ]) + +    def export_excel(self, path): +        from openpyxl import Workbook +        from openpyxl.styles import Font, Alignment + +        wb = Workbook() + +        ws1 = wb.active +        ws1.title = "浣跨敤璁板綍" +        ws1.append(['杩涚▼鍚?, '绐楀彛鏍囬', '搴旂敤鍚?, '寮€濮嬫椂闂?, '缁撴潫鏃堕棿', '鎸佺画绉掓暟']) +        for cell in ws1[1]: +            cell.font = Font(bold=True) +        sessions = self.db.get_all_sessions() +        for s in sessions: +            ws1.append([s['process_name'], s['window_title'], s['app_name'], +                        s['start_time'], s['end_time'], s['duration_seconds']]) +        for col in ws1.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws1.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        today = date.today() +        monday = today - timedelta(days=today.weekday()) + +        ws2 = wb.create_sheet("姣忔棩姹囨€?) +        ws2.append(['鏃ユ湡', '搴旂敤鍚?, '浣跨敤绉掓暟']) +        for cell in ws2[1]: +            cell.font = Font(bold=True) +        summaries = self.db.get_daily_summaries( +            monday.isoformat(), today.isoformat() +        ) +        for s in summaries: +            ws2.append([s['d'], s['app_name'], s['total_seconds']]) +        for col in ws2.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws2.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        ws3 = wb.create_sheet("搴旂敤鎺掕") +        ws3.append(['搴旂敤鍚?, '浣跨敤绉掓暟']) +        for cell in ws3[1]: +            cell.font = Font(bold=True) +        rank = self.db.get_app_rank() +        for r in rank: +            ws3.append([r['app_name'], r['total_seconds']]) +        for col in ws3.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws3.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        wb.save(path) +``` + +- [ ] **Step 3: Write and run tests** + +Create `tests/test_exporter.py`: + +```python +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +import csv +from datetime import datetime +from data.database import DatabaseManager +from export.exporter import Exporter + + +def test_export_csv(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'test', 'Chrome', now, now, 60) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.csv') +        exporter.export_csv(out_path) +        with open(out_path, encoding='utf-8-sig') as f: +            reader = csv.reader(f) +            rows = list(reader) +        assert len(rows) == 2 +        assert rows[0] == ['杩涚▼鍚?, '绐楀彛鏍囬', '搴旂敤鍚?, '寮€濮嬫椂闂?, '缁撴潫鏃堕棿', '鎸佺画绉掓暟'] +        assert 'Chrome' in rows[1][2] +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +def test_export_excel(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.xlsx') +        exporter.export_excel(out_path) +        assert os.path.exists(out_path) +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_export_csv() +    print('test_export_csv PASS') +    test_export_excel() +    print('test_export_excel PASS') +    print('All tests passed!') +``` + +Run: `python tests/test_exporter.py` +Expected: All tests PASS + +- [ ] **Step 4: Commit** + +```bash +git add export/ tests/test_exporter.py +git commit -m "feat: add CSV and Excel export functionality" +``` + +--- + +### Task 8: Main entry point + +**Files:** +- Create: `main.py` + +**Interfaces:** +- Consumes: all modules above + +- [ ] **Step 1: Write main.py** + +```python +import sys +from PySide6.QtWidgets import QApplication +from PySide6.QtCore import Qt, QTimer +from PySide6.QtGui import QFontDatabase, QFont +from data.database import DatabaseManager +from tracker.window_tracker import WindowTracker +from ui.tray_manager import TrayManager +from ui.main_window import MainWindow + + +def setup_global_font(app): +    font = QFont("PingFang SC", 10) +    font.setStyleStrategy(QFont.PreferAntialias) +    app.setFont(font) + + +def main(): +    app = QApplication(sys.argv) +    app.setApplicationName("Time Master") +    app.setOrganizationName("TimeMaster") +    app.setAttribute(Qt.AA_DontCreateNativeWidgetSiblings) + +    setup_global_font(app) + +    db = DatabaseManager() + +    window = MainWindow(db) + +    tracker = WindowTracker(db) +    tracker.start() + +    tray = TrayManager("Time Master") +    tray.show_main_window.connect(window.show) +    tray.show_main_window.connect(window.refresh_data) + +    def on_quit(): +        tracker.stop() +        tracker.wait(2000) +        db.close() +        app.quit() + +    tray.quit_app.connect(on_quit) +    tray.show() + +    window.refresh_data() + +    sys.exit(app.exec()) + + +if __name__ == '__main__': +    main() +``` + +- [ ] **Step 2: Commit** + +```bash +git add main.py +git commit -m "feat: add main entry point integrating all modules" +``` + +--- + +### Task 9: Generate test data and verify + +**Files:** +- Create: `tests/test_data_generator.py` + +- [ ] **Step 1: Write test data generator for demo/testing** + +```python +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +from datetime import datetime, timedelta +from data.database import DatabaseManager + + +def generate_test_data(db, days=7): +    now = datetime.now() +    apps = [ +        ('chrome.exe', 'Chrome'), +        ('Code.exe', 'VS Code'), +        ('WeChat.exe', '寰俊'), +        ('WindowsTerminal.exe', '缁堢'), +    ] +    import random +    for d in range(days): +        day_start = now - timedelta(days=days - 1 - d) +        day_start = day_start.replace(hour=8, minute=0, second=0, microsecond=0) +        for _ in range(random.randint(3, 8)): +            app = random.choice(apps) +            duration = random.randint(300, 7200) +            start = day_start + timedelta(seconds=random.randint(0, 43200)) +            end = start + timedelta(seconds=duration) +            db.insert_session(app[0], app[0], app[1], start, end, duration) +    print(f"Generated test data for {days} days") + + +if __name__ == '__main__': +    appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +    db_dir = os.path.join(appdata, 'Time Master') +    os.makedirs(db_dir, exist_ok=True) +    db_path = os.path.join(db_dir, 'data.db') +    import argparse +    parser = argparse.ArgumentParser() +    parser.add_argument('--days', type=int, default=7) +    parser.add_argument('--db', type=str, default=db_path) +    args = parser.parse_args() +    db = DatabaseManager(args.db) +    generate_test_data(db, args.days) +    db.close() +    print(f"Data written to {args.db}") +``` + +```bash +python tests/test_data_generator.py --days 7 +``` + +Expected: Generates sample data for visual testing, no errors. + +- [ ] **Step 2: Run the app to verify** + +```bash +python main.py +``` + +Expected: System tray icon appears. Double-click opens main window with Mica glass effect, showing today's stats and weekly trend. App usage ranking visible. + +- [ ] **Step 3: Commit** + +```bash +git add -A +git commit -m "chore: add test data generator and verify full app integration" +``` + +--- + +### Task 10: Packaging with PyInstaller + +**Files:** +- Create: `Time Master.spec` (or use command-line directly) + +- [ ] **Step 1: Install PyInstaller and create executable** + +```bash +pip install pyinstaller +pyinstaller --onefile --noconsole --name "Time Master" main.py +``` + +Expected: `dist/Time Master.exe` generated, ~30-50MB + +- [ ] **Step 2: Commit** + +```bash +git add -A +git commit -m "chore: add PyInstaller packaging config" +``` diff --git a/AICOP/Projects/Time Master/docs/superpowers/specs/2026-07-12-time-master-design.md b/AICOP/Projects/Time Master/docs/superpowers/specs/2026-07-12-time-master-design.