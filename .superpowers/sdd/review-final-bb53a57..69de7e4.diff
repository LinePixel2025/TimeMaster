.py** + +```python +``` + +- [ ] **Step 3: Write the DatabaseManager class** + +Create `data/database.py`: + +```python +import sqlite3 +import os +from datetime import datetime, date, timedelta + + +class DatabaseManager: +    def __init__(self, db_path=None): +        if db_path is None: +            appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +            db_dir = os.path.join(appdata, 'Time Master') +            os.makedirs(db_dir, exist_ok=True) +            db_path = os.path.join(db_dir, 'data.db') +        self.conn = sqlite3.connect(db_path, check_same_thread=False) +        self.conn.row_factory = sqlite3.Row +        self._migrate() + +    def _migrate(self): +        cur = self.conn.cursor() +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS sessions ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                process_name TEXT NOT NULL, +                window_title TEXT NOT NULL DEFAULT '', +                app_name TEXT NOT NULL, +                start_time TEXT NOT NULL, +                end_time TEXT, +                duration_seconds INTEGER DEFAULT 0 +            ) +        ''') +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS daily_summary ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                date TEXT NOT NULL, +                app_name TEXT NOT NULL, +                total_seconds INTEGER DEFAULT 0, +                UNIQUE(date, app_name) +            ) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_start ON sessions(start_time) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_app ON sessions(app_name) +        ''') +        self.conn.commit() + +    def insert_session(self, process_name, window_title, app_name, start_time, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            INSERT INTO sessions (process_name, window_title, app_name, start_time, end_time, duration_seconds) +            VALUES (?, ?, ?, ?, ?, ?) +        ''', (process_name, window_title, app_name, start_time.isoformat(), end_time.isoformat() if end_time else None, duration_seconds)) +        self.conn.commit() +        return cur.lastrowid + +    def update_session_end(self, session_id, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            UPDATE sessions SET end_time=?, duration_seconds=? WHERE id=? +        ''', (end_time.isoformat(), duration_seconds, session_id)) +        self.conn.commit() + +    def get_today_summary(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (today_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_today_total(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT COALESCE(SUM(duration_seconds), 0) as total +            FROM sessions WHERE date(start_time) = ? +        ''', (today_str,)) +        row = cur.fetchone() +        return row['total'] if row else 0 + +    def get_week_summary(self): +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT date(start_time) as d, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) >= ? AND date(start_time) <= ? +            GROUP BY date(start_time) +            ORDER BY d ASC +        ''', (monday.isoformat(), today.isoformat())) +        return [dict(r) for r in cur.fetchall()] + +    def get_app_rank(self, target_date=None): +        if target_date is None: +            target_date = date.today() +        date_str = target_date.isoformat() if isinstance(target_date, date) else target_date +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (date_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_all_sessions(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT * FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                ORDER BY start_time ASC +            ''', (start_date, end_date)) +        else: +            cur.execute('SELECT * FROM sessions ORDER BY start_time ASC') +        return [dict(r) for r in cur.fetchall()] + +    def get_daily_summaries(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''', (start_date, end_date)) +        else: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''') +        return [dict(r) for r in cur.fetchall()] + +    def close(self): +        self.conn.close() +``` + +- [ ] **Step 4: Write and run tests** + +Create `tests/test_database.py`: + +```python +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +from datetime import datetime, date, timedelta +from data.database import DatabaseManager + + +def test_create_table(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        cur = db.conn.cursor() +        cur.execute("SELECT name FROM sqlite_master WHERE type='table'") +        tables = [r['name'] for r in cur.fetchall()] +        assert 'sessions' in tables +        assert 'daily_summary' in tables +        db.close() +    finally: +        os.unlink(db_path) + + +def test_insert_and_query(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        sid = db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        assert sid is not None +        summary = db.get_today_summary() +        assert len(summary) == 1 +        assert summary[0]['app_name'] == 'Chrome' +        assert summary[0]['total_seconds'] == 60 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_week_summary(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        week = db.get_week_summary() +        assert len(week) >= 1 +        assert week[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_app_rank(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        rank = db.get_app_rank() +        assert len(rank) == 2 +        assert rank[0]['app_name'] == 'VS Code' +        assert rank[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_create_table() +    print('test_create_table PASS') +    test_insert_and_query() +    print('test_insert_and_query PASS') +    test_week_summary() +    print('test_week_summary PASS') +    test_app_rank() +    print('test_app_rank PASS') +    print('All tests passed!') +``` + +Run: `python tests/test_database.py` +Expected: All tests PASS + +- [ ] **Step 5: Commit** + +```bash +git add requirements.txt data/ tests/test_database.py +git commit -m "feat: add database layer with SQLite schema and CRUD operations" +``` + +--- diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-1-report.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-1-report.md new file mode 100644 index 0000000..1ef7cfb --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-1-report.md	 @@ -0,0 +1,47 @@ +# Task 1 Report: Project Scaffolding + Database Layer + +## What I implemented + +- **`requirements.txt`** 鈥?Python dependencies (PySide6, pywin32, psutil, openpyxl, pyqtgraph) +- **`data/__init__.py`** 鈥?Empty init for package +- **`data/database.py`** 鈥?`DatabaseManager` class with SQLite-backed schema and full CRUD: +  - `__init__(db_path)` 鈥?creates/connects to SQLite DB, runs migrations +  - `_migrate()` 鈥?creates `sessions` and `daily_summary` tables with indexes +  - `insert_session(...)` 鈫?int 鈥?inserts a session row, returns ID +  - `update_session_end(session_id, end_time, duration_seconds)` 鈥?updates end time +  - `get_today_summary()` 鈫?`[{app_name, total_seconds}]` +  - `get_today_total()` 鈫?int +  - `get_week_summary()` 鈫?`[{date, total_seconds}]` +  - `get_app_rank(target_date)` 鈫?`[{app_name, total_seconds}]` +  - `get_all_sessions(start_date, end_date)` 鈫?list of dicts +  - `get_daily_summaries(start_date, end_date)` 鈫?list of dicts +  - `close()` 鈥?closes connection +- **`tests/__init__.py`** 鈥?Empty init +- **`tests/test_database.py`** 鈥?4 test functions +- **`.gitignore`** 鈥?Excludes `__pycache__/`, `*.pyc`, `*.pyo`, `*.db*` + +## Test Results + +All 4 tests pass: +- `test_create_table` 鈥?verifies both tables exist +- `test_insert_and_query` 鈥?insert session and verify today summary +- `test_week_summary` 鈥?insert and verify week summary +- `test_app_rank` 鈥?insert two sessions and verify ranking + +## Files Changed + +- `.gitignore` (created) +- `requirements.txt` (created) +- `data/__init__.py` (created) +- `data/database.py` (created) +- `tests/__init__.py` (created) +- `tests/test_database.py` (created) + +## Self-Review Findings + +- `__pycache__` files were accidentally committed on first attempt; fixed by adding `.gitignore` and amending the commit. +- `tests/__init__.py` was missing from the staged set in the brief's commit command; added in the amend. + +## Concerns + +None. Foundational layer is solid. diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-10-brief.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-10-brief.md new file mode 100644 index 0000000..377c45b --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-10-brief.md	 @@ -0,0 +1,20 @@ +锘?## Task 10: Packaging with PyInstaller + +**Files:** +- Create: `Time Master.spec` (or use command-line directly) + +- [ ] **Step 1: Install PyInstaller and create executable** + +```bash +pip install pyinstaller +pyinstaller --onefile --noconsole --name "Time Master" main.py +``` + +Expected: `dist/Time Master.exe` generated, ~30-50MB + +- [ ] **Step 2: Commit** + +```bash +git add -A +git commit -m "chore: add PyInstaller packaging config" +``` diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-2-brief.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-2-brief.md new file mode 100644 index 0000000..7deb1a7 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-2-brief.md	 @@ -0,0 +1,246 @@ +锘?## Task 2: Window tracker (QThread) + +**Files:** +- Create: `tracker/__init__.py` +- Create: `tracker/window_tracker.py` +- Create: `tests/test_window_tracker.py` + +**Interfaces:** +- Consumes: `DatabaseManager` from Task 1 +- Produces: `WindowTracker(db: DatabaseManager)` class extending `QThread`: +  - Signal: `active_window_changed(process_name, window_title, app_name)` +  - Signal: `idle_changed(is_idle: bool)` +  - `run()`: main polling loop +  - `stop()`: stop the loop +  - `_get_foreground_window_info()` 閳?`(process_name, window_title, app_name)` or `None` + +- [ ] **Step 1: Create tracker/__init__.py** + +```python +``` + +- [ ] **Step 2: Write app classification utility** + +Add to `tracker/window_tracker.py`: + +```python +import os + + +APP_NAME_MAP = { +    'chrome.exe': 'Chrome', +    'msedge.exe': 'Edge', +    'firefox.exe': 'Firefox', +    'Code.exe': 'VS Code', +    'WeChat.exe': '瀵邦喕淇?, +    'WeChatWork.exe': '娴间椒绗熷顔讳繆', +    'sublime_text.exe': 'Sublime Text', +    'cmd.exe': '閸涙垝鎶ょ悰?, +    'WindowsTerminal.exe': '缂佸牏顏?, +    'explorer.exe': '閺傚洣娆㈢挧鍕爱缁狅紕鎮婇崳?, +    'OUTLOOK.EXE': 'Outlook', +    'WINWORD.EXE': 'Word', +    'EXCEL.EXE': 'Excel', +    'POWERPNT.EXE': 'PowerPoint', +    'wmplayer.exe': 'Windows Media Player', +    'Spotify.exe': 'Spotify', +    'Obsidian.exe': 'Obsidian', +    'notepad.exe': '鐠侀绨ㄩ張?, +    'notepad++.exe': 'Notepad++', +    'pycharm64.exe': 'PyCharm', +    'idea64.exe': 'IntelliJ IDEA', +    'clion64.exe': 'CLion', +    'goland64.exe': 'GoLand', +    'devenv.exe': 'Visual Studio', +    'typora.exe': 'Typora', +    'Foxmail.exe': 'Foxmail', +    'DingTalk.exe': '闁藉鎷?, +    'Lark.exe': '妞嬬偘鍔?, +    'Slack.exe': 'Slack', +    'Discord.exe': 'Discord', +    'Telegram.exe': 'Telegram', +    'PotPlayer.exe': 'PotPlayer', +    'eclipse.exe': 'Eclipse', +    'AndroidStudio.exe': 'Android Studio', +    'Tableau.exe': 'Tableau', +    'Figma.exe': 'Figma', +    'Photoshop.exe': 'Photoshop', +    'winword.exe': 'Word', +    'excel.exe': 'Excel', +    'powerpnt.exe': 'PowerPoint', +    'outlook.exe': 'Outlook', +} + + +def classify_app(process_name): +    name = os.path.basename(process_name) +    return APP_NAME_MAP.get(name, os.path.splitext(name)[0]) +``` + +- [ ] **Step 3: Write the WindowTracker class** + +```python +import time +from datetime import datetime +from PySide6.QtCore import QThread, Signal + + +class WindowTracker(QThread): +    active_window_changed = Signal(str, str, str) +    idle_changed = Signal(bool) + +    POLL_INTERVAL = 1.0 +    IDLE_THRESHOLD = 60 + +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._running = False +        self._current_session_id = None +        self._current_pid = None +        self._current_process = None +        self._current_title = None +        self._current_app = None +        self._session_start = None +        self._idle_seconds = 0 +        self._is_idle = False + +    def stop(self): +        self._running = False + +    def run(self): +        self._running = True +        while self._running: +            try: +                self._tick() +            except Exception: +                pass +            time.sleep(self.POLL_INTERVAL) + +    def _tick(self): +        info = self._get_foreground_window_info() +        now = datetime.now() + +        if info is None: +            self._idle_seconds += self.POLL_INTERVAL +            if self._idle_seconds >= self.IDLE_THRESHOLD and not self._is_idle: +                self._is_idle = True +                self.idle_changed.emit(True) +                self._close_current_session(now) +            return + +        self._idle_seconds = 0 +        if self._is_idle: +            self._is_idle = False +            self.idle_changed.emit(False) + +        pid, process_name, window_title, app_name = info + +        if (pid != self._current_pid or +                window_title != self._current_title): +            self._close_current_session(now) +            self._current_pid = pid +            self._current_process = process_name +            self._current_title = window_title +            self._current_app = app_name +            self._session_start = now +            sid = self.db.insert_session( +                process_name, window_title, app_name, +                now, None, 0 +            ) +            self._current_session_id = sid +            self.active_window_changed.emit(process_name, window_title, app_name) +        else: +            if self._current_session_id is not None and self._session_start is not None: +                duration = int((now - self._session_start).total_seconds()) +                self.db.update_session_end(self._current_session_id, now, duration) + +    def _close_current_session(self, now): +        if self._current_session_id is not None and self._session_start is not None: +            duration = int((now - self._session_start).total_seconds()) +            self.db.update_session_end(self._current_session_id, now, duration) +            self._current_session_id = None +            self._session_start = None + +    def _get_foreground_window_info(self): +        try: +            import win32gui +            import win32process +            import psutil +            hwnd = win32gui.GetForegroundWindow() +            if hwnd == 0: +                return None +            _, pid = win32process.GetWindowThreadProcessId(hwnd) +            try: +                proc = psutil.Process(pid) +                process_name = proc.name() +            except (psutil.NoSuchProcess, psutil.AccessDenied): +                process_name = f'pid_{pid}' +            window_title = win32gui.GetWindowText(hwnd) +            if not window_title: +                window_title = process_name +            app_name = classify_app(process_name) +            return (pid, process_name, window_title, app_name) +        except Exception: +            return None +``` + +- [ ] **Step 4: Write and run tests** + +Create `tests/test_window_tracker.py`: + +```python +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +from data.database import DatabaseManager +from tracker.window_tracker import classify_app + + +def test_classify_known(): +    assert classify_app('chrome.exe') == 'Chrome' +    assert classify_app('Code.exe') == 'VS Code' +    assert classify_app('WeChat.exe') == '瀵邦喕淇? +    assert classify_app('OUTLOOK.EXE') == 'Outlook' + + +def test_classify_unknown(): +    result = classify_app('some_random_app.exe') +    assert result == 'some_random_app' + + +def test_classify_case_sensitive(): +    assert classify_app('WINWORD.EXE') == 'Word' +    assert classify_app('winword.exe') == 'Word' + + +def test_classify_no_ext(): +    result = classify_app('myapp.exe') +    assert result == 'myapp' + + +if __name__ == '__main__': +    test_classify_known() +    print('test_classify_known PASS') +    test_classify_unknown() +    print('test_classify_unknown PASS') +    test_classify_case_sensitive() +    print('test_classify_case_sensitive PASS') +    test_classify_no_ext() +    print('test_classify_no_ext PASS') +    print('All tests passed!') +``` + +Run: `python tests/test_window_tracker.py` +Expected: All tests PASS + +- [ ] **Step 5: Commit** + +```bash +git add tracker/ tests/test_window_tracker.py +git commit -m "feat: add window tracker with foreground window detection and app classification" +``` + +--- diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-2-report.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-2-report.md new file mode 100644 index 0000000..a060b5a --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-2-report.md	 @@ -0,0 +1,32 @@ +# Task 2: Window Tracker 鈥?Report + +**Status:** DONE + +## Commits + +- `ab465dc` 鈥?feat: add window tracker with foreground window detection and app classification + +## Files Created + +| File | Lines | Purpose | +|------|-------|---------| +| `tracker/__init__.py` | 0 | Package init (empty) | +| `tracker/window_tracker.py` | 159 | `APP_NAME_MAP`, `classify_app()`, `WindowTracker(QThread)` | +| `tests/test_window_tracker.py` | 39 | Unit tests for `classify_app()` | + +## Test Summary + +All 4 tests pass (run via `python tests/test_window_tracker.py`): + +- `test_classify_known` 鈥?known exe names return friendly names +- `test_classify_unknown` 鈥?unknown .exe strips extension +- `test_classify_case_sensitive` 鈥?uppercase/lowercase both match (`WINWORD.EXE`, `winword.exe`) +- `test_classify_no_ext` 鈥?`.exe` removal for unknown entries + +## Deviation from Brief + +The `from PySide6.QtCore import QThread, Signal` import was wrapped in a `try/except ImportError` fallback so that `classify_app` can be imported without PySide6 installed. PySide6 was not installable in this environment (download timeouts on ~168MB package). The `WindowTracker` class remains a proper `QThread` subclass and works identically when PySide6 is available. + +## Concerns + +None. diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-3-brief.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-3-brief.md new file mode 100644 index 0000000..b434e8c --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-3-brief.md	 @@ -0,0 +1,93 @@ +锘?## Task 3: System tray manager + +**Files:** +- Create: `ui/__init__.py` +- Create: `ui/tray_manager.py` + +**Interfaces:** +- Consumes: nothing directly (signals connect in main.py) +- Produces: `TrayManager(app_name="Time Master")` class: +  - Signal: `show_main_window` +  - Signal: `quit_app` +  - `set_tooltip(text)`: update tray tooltip +  - `show_notification(title, message)`: show Windows notification + +- [ ] **Step 1: Create ui/__init__.py** + +```python +``` + +- [ ] **Step 2: Write TrayManager** + +Create `ui/tray_manager.py`: + +```python +from PySide6.QtWidgets import QSystemTrayIcon, QMenu +from PySide6.QtGui import QIcon, QAction, QPainter, QPixmap, QColor, QFont, QBrush, QPen +from PySide6.QtCore import Signal, QObject, Qt + + +def create_default_icon(): +    size = 64 +    pixmap = QPixmap(size, size) +    pixmap.fill(Qt.transparent) +    painter = QPainter(pixmap) +    painter.setRenderHint(QPainter.Antialiasing) +    painter.setBrush(QBrush(QColor("#6366F1"))) +    painter.setPen(QPen(QColor("#6366F1"), 0)) +    painter.drawRoundedRect(4, 4, size - 8, size - 8, 12, 12) +    painter.setPen(QColor("white")) +    font = QFont("PingFang SC", 28, QFont.Bold) +    painter.setFont(font) +    painter.drawText(pixmap.rect(), Qt.AlignCenter, "T") +    painter.end() +    return QIcon(pixmap) + + +class TrayManager(QObject): +    show_main_window = Signal() +    quit_app = Signal() + +    def __init__(self, app_name="Time Master", parent=None): +        super().__init__(parent) +        self.app_name = app_name +        self.tray = QSystemTrayIcon(self) +        self.tray.setIcon(create_default_icon()) +        self.tray.setToolTip(app_name) + +        menu = QMenu() +        show_action = QAction("閺勫墽銇氭稉鑽ゆ櫕闂?, self) +        show_action.triggered.connect(self.show_main_window.emit) +        menu.addAction(show_action) + +        menu.addSeparator() + +        quit_action = QAction("闁偓閸?, self) +        quit_action.triggered.connect(self.quit_app.emit) +        menu.addAction(quit_action) + +        self.tray.setContextMenu(menu) +        self.tray.activated.connect(self._on_activated) + +    def _on_activated(self, reason): +        if reason == QSystemTrayIcon.ActivationReason.DoubleClick: +            self.show_main_window.emit() + +    def set_tooltip(self, text): +        self.tray.setToolTip(text) + +    def show_notification(self, title, message): +        self.tray.showMessage(title, message, QIcon(), 3000) + +    def show(self): +        self.tray.show() +``` + +- [ ] **Step 3: Commit** + +```bash +git add ui/ +git commit -m "feat: add system tray manager with icon and menu" +``` + +--- diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-3-report.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-3-report.md new file mode 100644 index 0000000..f8dc752 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-3-report.md	 @@ -0,0 +1,32 @@ +# Task 3 Report: System Tray Manager + +## What I implemented + +- Created `ui/__init__.py` 鈥?empty init module +- Created `ui/tray_manager.py` 鈥?`TrayManager` class with: +  - `show_main_window` and `quit_app` signals +  - `create_default_icon()` 鈥?programmatic 64脳64 indigo rounded-rect icon with white "T" text +  - Context menu with "鏄剧ず涓荤晫闈? (Show) and "閫€鍑? (Quit) actions +  - Double-click tray icon triggers `show_main_window` +  - `set_tooltip(text)`, `show_notification(title, message)`, `show()` methods +  - Notification duration: 3000ms +  - Default app name: "Time Master" + +## Test results + +No tests were created 鈥?the brief did not specify tests, and this is a UI component that requires a running QApplication and system tray to test. + +## Self-review findings + +- Fixed encoding: brief contained mojibake for Chinese labels; restored proper Chinese characters "鏄剧ず涓荤晫闈? and "閫€鍑? +- All code matches the interface specification from the brief +- No linting/typechecking run 鈥?brief did not provide commands and no `pyproject.toml` or `ruff` config found + +## Files changed + +- `ui/__init__.py` (created, 0 lines) +- `ui/tray_manager.py` (created, 59 lines) + +## Commit + +- `67a2616` 鈥?`feat: add system tray manager with icon and menu` diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-4-brief.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-4-brief.md new file mode 100644 index 0000000..cae6361 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-4-brief.md	 @@ -0,0 +1,206 @@ +锘?## Task 4: Stats widgets (today's usage + weekly trend) + +**Files:** +- Create: `ui/stats_widget.py` + +**Interfaces:** +- Consumes: `DatabaseManager.get_today_total()`, `DatabaseManager.get_week_summary()` +- Produces: `StatsWidget(db: DatabaseManager)` class extending `QWidget`: +  - `refresh()`: reload data from DB and repaint + +- [ ] **Step 1: Write StatsWidget** + +Create `ui/stats_widget.py`: + +```python +from PySide6.QtWidgets import QWidget, QVBoxLayout, QHBoxLayout, QLabel, QFrame +from PySide6.QtGui import QPainter, QColor, QPen, QBrush, QFont, QPainterPath, QLinearGradient +from PySide6.QtCore import Qt, QRectF, Signal, QTimer +from datetime import date, timedelta + + +class CircularProgress(QWidget): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setFixedSize(140, 140) +        self._value = 0 +        self._max_value = 86400 +        self._hours = 0 +        self._minutes = 0 + +    def set_value(self, total_seconds): +        self._value = min(total_seconds, self._max_value) +        total_minutes = total_seconds // 60 +        self._hours = total_minutes // 60 +        self._minutes = total_minutes % 60 +        self.update() + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) + +        rect = QRectF(10, 10, 120, 120) +        pen_width = 10 + +        bg_pen = QPen(QColor(255, 255, 255, 30), pen_width) +        bg_pen.setCapStyle(Qt.RoundCap) +        painter.setPen(bg_pen) +        painter.drawArc(rect, 0, 360 * 16) + +        ratio = self._value / self._max_value +        gradient = QLinearGradient(0, 0, 140, 140) +        gradient.setColorAt(0.0, QColor("#818CF8")) +        gradient.setColorAt(1.0, QColor("#6366F1")) +        fg_pen = QPen(QBrush(gradient), pen_width) +        fg_pen.setCapStyle(Qt.RoundCap) +        painter.setPen(fg_pen) +        span = int(-ratio * 360 * 16) +        painter.drawArc(rect, 90 * 16, span) + +        font_h = QFont("PingFang SC", 32, QFont.Light) +        painter.setFont(font_h) +        painter.setPen(QColor(255, 255, 255)) +        painter.drawText(QRectF(0, 40, 140, 50), Qt.AlignCenter, f"{self._hours}") + +        font_m = QFont("PingFang SC", 14, QFont.Normal) +        painter.setFont(font_m) +        painter.setPen(QColor(255, 255, 255, 180)) +        painter.drawText(QRectF(0, 82, 140, 30), Qt.AlignCenter, f"{self._minutes} 閸掑棝鎸?) + + +class GlassCard(QFrame): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setStyleSheet(""" +            GlassCard { +                background-color: rgba(255, 255, 255, 8); +                border-radius: 16px; +            } +        """) + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) +        path = QPainterPath() +        path.addRoundedRect(0, 0, self.width(), self.height(), 16, 16) +        gradient = QLinearGradient(0, 0, 0, self.height()) +        gradient.setColorAt(0.0, QColor(255, 255, 255, 25)) +        gradient.setColorAt(1.0, QColor(255, 255, 255, 8)) +        painter.fillPath(path, QBrush(gradient)) +        pen = QPen(QColor(255, 255, 255, 30), 1) +        painter.setPen(pen) +        painter.drawPath(path) + + +class WeeklyBar(QWidget): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setFixedHeight(120) +        self._data = {} +        self._max_val = 1 + +    def set_data(self, week_data): +        day_names = ['娑撯偓', '娴?, '娑?, '閸?, '娴?, '閸?, '閺?] +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        self._data = {} +        self._max_val = 1 +        for i in range(7): +            d = (monday + timedelta(days=i)).isoformat() +            self._data[d] = 0 +        for item in week_data: +            if item['d'] in self._data: +                self._data[item['d']] = item['total_seconds'] +        self._max_val = max(self._data.values()) if self._data else 1 +        if self._max_val == 0: +            self._max_val = 1 +        self.update() + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) + +        w = self.width() +        h = self.height() +        bar_count = 7 +        bar_w = min(32, (w - 40) // bar_count) +        gap = (w - 40 - bar_w * bar_count) // (bar_count - 1) if bar_count > 1 else 0 +        start_x = 20 +        label_y = h - 20 + +        day_names = ['娑撯偓', '娴?, '娑?, '閸?, '娴?, '閸?, '閺?] +        today = date.today() +        monday = today - timedelta(days=today.weekday()) + +        font_small = QFont("PingFang SC", 11) +        painter.setFont(font_small) + +        for i in range(7): +            x = start_x + i * (bar_w + gap) +            d = (monday + timedelta(days=i)).isoformat() +            val = self._data.get(d, 0) +            bar_h = int((val / self._max_val) * (label_y - 30)) if self._max_val > 0 else 0 +            if bar_h > 0: +                gradient = QLinearGradient(x, label_y - 20 - bar_h, x, label_y - 20) +                gradient.setColorAt(0.0, QColor("#A5B4FC")) +                gradient.setColorAt(1.0, QColor("#6366F1")) +                painter.setBrush(QBrush(gradient)) +                painter.setPen(Qt.NoPen) +                path = QPainterPath() +                path.addRoundedRect(x, label_y - 20 - bar_h, bar_w, bar_h, 4, 4) +                painter.drawPath(path) + +            painter.setPen(QColor(255, 255, 255, 160)) +            painter.drawText(QRectF(x, label_y - 5, bar_w, 20), Qt.AlignCenter, day_names[i]) +            if val > 0: +                mins = val // 60 +                painter.setPen(QColor(255, 255, 255, 100)) +                painter.drawText(QRectF(x, label_y - 28 - bar_h, bar_w, 16), Qt.AlignCenter, f"{mins}m") + + +class StatsWidget(QWidget): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        layout = QHBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(16) + +        today_card = GlassCard(self) +        today_layout = QVBoxLayout(today_card) +        today_layout.setAlignment(Qt.AlignCenter) +        today_title = QLabel("娴犲﹥妫╂担璺ㄦ暏") +        today_title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        today_title.setStyleSheet("color: rgba(255,255,255,180);") +        today_title.setAlignment(Qt.AlignCenter) +        self.circular_progress = CircularProgress() +        today_layout.addWidget(today_title) +        today_layout.addWidget(self.circular_progress, 0, Qt.AlignCenter) +        layout.addWidget(today_card) + +        week_card = GlassCard(self) +        week_layout = QVBoxLayout(week_card) +        week_title = QLabel("閺堫剙鎳嗙搾瀣◢") +        week_title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        week_title.setStyleSheet("color: rgba(255,255,255,180);") +        week_title.setAlignment(Qt.AlignCenter) +        self.weekly_bar = WeeklyBar() +        week_layout.addWidget(week_title) +        week_layout.addWidget(self.weekly_bar) +        layout.addWidget(week_card) + +    def refresh(self): +        total = self.db.get_today_total() +        self.circular_progress.set_value(total) +        week_data = self.db.get_week_summary() +        self.weekly_bar.set_data(week_data) +``` + +- [ ] **Step 2: Commit** + +```bash +git add ui/stats_widget.py +git commit -m "feat: add today's usage circular progress and weekly trend bar chart" +``` + +--- diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-4-report.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-4-report.md new file mode 100644 index 0000000..54dae51 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-4-report.md	 @@ -0,0 +1,17 @@ +# Task 4 Report: Stats Widgets + +## Status +- **Completed**: Yes + +## Commits +- `b4b86f5` - feat: add today's usage circular progress and weekly trend bar chart + +## Files Created +- `ui/stats_widget.py` 鈥?StatsWidget, CircularProgress, GlassCard, WeeklyBar classes + +## Test Summary +- Syntax verified (Python AST parse passes) +- No automated tests possible 鈥?PySide6 widgets require QApplication runtime + +## Concerns +- None. All interfaces (`DatabaseManager.get_today_total()`, `get_week_summary()`) confirmed present in `data/database.py`. diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/task-5-brief.md b/AICOP/Projects/Time Master/.superpowers/sdd/task-5-brief.md new file mode 100644 index 0000000..f0c63bb --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/task-5-brief.md	 @@ -0,0 +1,111 @@ +锘?## Task 5: App rank widget + +**Files:** +- Create: `ui/app_rank_widget.py` + +**Interfaces:** +- Consumes: `DatabaseManager.get_app_rank()` +- Produces: `AppRankWidget(db: DatabaseManager)` class extending `QWidget`: +  - `refresh()`: reload data and repaint + +- [ ] **Step 1: Write AppRankWidget** + +Create `ui/app_rank_widget.py`: + +```python +from PySide6.QtWidgets import QWidget, QVBoxLayout, QLabel, QFrame, QHBoxLayout +from PySide6.QtGui import QPainter, QColor, QPen, QBrush, QFont, QLinearGradient, QPainterPath +from PySide6.QtCore import Qt, QRectF + + +class AppRankItem(QWidget): +    def __init__(self, rank, app_name, total_seconds, max_seconds, parent=None): +        super().__init__(parent) +        self.setFixedHeight(48) +        self.rank = rank +        self.app_name = app_name +        self.total_seconds = total_seconds +        self.max_seconds = max_seconds +        self.setMouseTracking(False) + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) +        w = self.width() +        h = self.height() +        bar_max_w = w - 200 + +        painter.setFont(QFont("PingFang SC", 13, QFont.Normal)) +        painter.setPen(QColor(255, 255, 255, 200)) +        painter.drawText(QRectF(8, 0, 30, h), Qt.AlignLeft | Qt.AlignVCenter, str(self.rank)) + +        painter.setPen(QColor(255, 255, 255, 220)) +        painter.drawText(QRectF(40, 0, 100, h), Qt.AlignLeft | Qt.AlignVCenter, self.app_name) + +        ratio = self.total_seconds / self.max_seconds if self.max_seconds > 0 else 0 +        bar_w = int(bar_max_w * ratio) +        if bar_w > 0: +            gradient = QLinearGradient(0, 0, bar_w, 0) +            gradient.setColorAt(0.0, QColor("#818CF8")) +            gradient.setColorAt(1.0, QColor("#6366F1")) +            painter.setBrush(QBrush(gradient)) +            painter.setPen(Qt.NoPen) +            path = QPainterPath() +            path.addRoundedRect(140, h // 2 - 6, bar_w, 12, 6, 6) +            painter.drawPath(path) + +        mins = self.total_seconds // 60 +        hours = mins // 60 +        remain_mins = mins % 60 +        if hours > 0: +            time_str = f"{hours}h {remain_mins}m" +        else: +            time_str = f"{remain_mins}m" +        painter.setPen(QColor(255, 255, 255, 140)) +        painter.drawText(QRectF(w - 60, 0, 55, h), Qt.AlignRight | Qt.AlignVCenter, time_str) + + +class AppRankWidget(QFrame): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._items = [] +        layout = QVBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(4) + +        title = QLabel("鎼存梻鏁ゆ担璺ㄦ暏閹烘帟顢?(娴犲﹥妫?") +        title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        title.setStyleSheet("color: rgba(255,255,255,180);") +        layout.addWidget(title) + +        self.list_widget = QWidget() +        self.list_layout = QVBoxLayout(self.list_widget) +        self.list_layout.setContentsMargins(0, 8, 0, 0) +        self.list_layout.setSpacing(2) +        layout.addWidget(self.list_widget) + +    def refresh(self): +        data = self.db.get_app_rank() +        while self.list_layout.count(): +            item = self.list_layout.takeAt(0) +            if item.widget(): +                item.widget().deleteLater() +        max_sec = data[0]['total_seconds'] if data else 1 +        for i, 