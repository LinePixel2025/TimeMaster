ex 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/export/exporter.py b/AICOP/Projects/Time Master/export/exporter.py new file mode 100644 index 0000000..d8b9335 --- /dev/null +++ b/AICOP/Projects/Time Master/export/exporter.py	 @@ -0,0 +1,66 @@ +import csv +from datetime import date, timedelta + + +class Exporter: +    def __init__(self, db): +        self.db = db + +    def export_csv(self, path): +        sessions = self.db.get_all_sessions() +        with open(path, 'w', newline='', encoding='utf-8-sig') as f: +            writer = csv.writer(f) +            writer.writerow(['\u8fdb\u7a0b\u540d', '\u7a97\u53e3\u6807\u9898', '\u5e94\u7528\u540d', '\u5f00\u59cb\u65f6\u95f4', '\u7ed3\u675f\u65f6\u95f4', '\u6301\u7eed\u79d2\u6570']) +            for s in sessions: +                writer.writerow([ +                    s['process_name'], s['window_title'], s['app_name'], +                    s['start_time'], s['end_time'], s['duration_seconds'] +                ]) + +    def export_excel(self, path): +        from openpyxl import Workbook +        from openpyxl.styles import Font, Alignment + +        wb = Workbook() + +        ws1 = wb.active +        ws1.title = '\u4f7f\u7528\u8bb0\u5f55' +        ws1.append(['\u8fdb\u7a0b\u540d', '\u7a97\u53e3\u6807\u9898', '\u5e94\u7528\u540d', '\u5f00\u59cb\u65f6\u95f4', '\u7ed3\u675f\u65f6\u95f4', '\u6301\u7eed\u79d2\u6570']) +        for cell in ws1[1]: +            cell.font = Font(bold=True) +        sessions = self.db.get_all_sessions() +        for s in sessions: +            ws1.append([s['process_name'], s['window_title'], s['app_name'], +                        s['start_time'], s['end_time'], s['duration_seconds']]) +        for col in ws1.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws1.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        today = date.today() +        monday = today - timedelta(days=today.weekday()) + +        ws2 = wb.create_sheet('\u6bcf\u65e5\u6c47\u603b') +        ws2.append(['\u65e5\u671f', '\u5e94\u7528\u540d', '\u4f7f\u7528\u79d2\u6570']) +        for cell in ws2[1]: +            cell.font = Font(bold=True) +        summaries = self.db.get_daily_summaries( +            monday.isoformat(), today.isoformat() +        ) +        for s in summaries: +            ws2.append([s['d'], s['app_name'], s['total_seconds']]) +        for col in ws2.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws2.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        ws3 = wb.create_sheet('\u5e94\u7528\u6392\u884c') +        ws3.append(['\u5e94\u7528\u540d', '\u4f7f\u7528\u79d2\u6570']) +        for cell in ws3[1]: +            cell.font = Font(bold=True) +        rank = self.db.get_app_rank() +        for r in rank: +            ws3.append([r['app_name'], r['total_seconds']]) +        for col in ws3.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws3.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        wb.save(path) diff --git a/AICOP/Projects/Time Master/main.py b/AICOP/Projects/Time Master/main.py new file mode 100644 index 0000000..9aa539e --- /dev/null +++ b/AICOP/Projects/Time Master/main.py	 @@ -0,0 +1,51 @@ +import sys +from PySide6.QtWidgets import QApplication +from PySide6.QtCore import Qt, QTimer +from PySide6.QtGui import QFontDatabase, QFont +from data.database import DatabaseManager +from tracker.window_tracker import WindowTracker +from ui.tray_manager import TrayManager +from ui.main_window import MainWindow + + +def setup_global_font(app): +    font = QFont("PingFang SC", 10) +    font.setStyleStrategy(QFont.PreferAntialias) +    app.setFont(font) + + +def main(): +    app = QApplication(sys.argv) +    app.setApplicationName("Time Master") +    app.setOrganizationName("TimeMaster") +    app.setAttribute(Qt.AA_DontCreateNativeWidgetSiblings) + +    setup_global_font(app) + +    db = DatabaseManager() + +    window = MainWindow(db) + +    tracker = WindowTracker(db) +    tracker.start() + +    tray = TrayManager("Time Master") +    tray.show_main_window.connect(window.show) +    tray.show_main_window.connect(window.refresh_data) + +    def on_quit(): +        tracker.stop() +        tracker.wait(2000) +        db.close() +        app.quit() + +    tray.quit_app.connect(on_quit) +    tray.show() + +    window.refresh_data() + +    sys.exit(app.exec()) + + +if __name__ == '__main__': +    main() diff --git a/AICOP/Projects/Time Master/requirements.txt b/AICOP/Projects/Time Master/requirements.txt new file mode 100644 index 0000000..509e63b --- /dev/null +++ b/AICOP/Projects/Time Master/requirements.txt	 @@ -0,0 +1,5 @@ +PySide6>=6.6.0 +pywin32>=306 +psutil>=5.9.0 +openpyxl>=3.1.0 +pyqtgraph>=0.13.0 diff --git a/AICOP/Projects/Time Master/tests/__init__.py b/AICOP/Projects/Time Master/tests/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/tests/test_data_generator.py b/AICOP/Projects/Time Master/tests/test_data_generator.py new file mode 100644 index 0000000..6a626bf --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_data_generator.py	 @@ -0,0 +1,43 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +from datetime import datetime, timedelta +from data.database import DatabaseManager + + +def generate_test_data(db, days=7): +    now = datetime.now() +    apps = [ +        ('chrome.exe', 'Chrome'), +        ('Code.exe', 'VS Code'), +        ('WeChat.exe', '\u5fae\u4fe1'), +        ('WindowsTerminal.exe', '\u7ec8\u7aef'), +    ] +    import random +    for d in range(days): +        day_start = now - timedelta(days=days - 1 - d) +        day_start = day_start.replace(hour=8, minute=0, second=0, microsecond=0) +        for _ in range(random.randint(3, 8)): +            app = random.choice(apps) +            duration = random.randint(300, 7200) +            start = day_start + timedelta(seconds=random.randint(0, 43200)) +            end = start + timedelta(seconds=duration) +            db.insert_session(app[0], app[0], app[1], start, end, duration) +    print(f"Generated test data for {days} days") + + +if __name__ == '__main__': +    appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +    db_dir = os.path.join(appdata, 'Time Master') +    os.makedirs(db_dir, exist_ok=True) +    db_path = os.path.join(db_dir, 'data.db') +    import argparse +    parser = argparse.ArgumentParser() +    parser.add_argument('--days', type=int, default=7) +    parser.add_argument('--db', type=str, default=db_path) +    args = parser.parse_args() +    db = DatabaseManager(args.db) +    generate_test_data(db, args.days) +    db.close() +    print(f"Data written to {args.db}") diff --git a/AICOP/Projects/Time Master/tests/test_database.py b/AICOP/Projects/Time Master/tests/test_database.py new file mode 100644 index 0000000..6eec87a --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_database.py	 @@ -0,0 +1,170 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +from datetime import datetime, date, timedelta +from data.database import DatabaseManager + + +def test_create_table(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        cur = db.conn.cursor() +        cur.execute("SELECT name FROM sqlite_master WHERE type='table'") +        tables = [r['name'] for r in cur.fetchall()] +        assert 'sessions' in tables +        assert 'daily_summary' in tables +        db.close() +    finally: +        os.unlink(db_path) + + +def test_insert_and_query(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        sid = db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        assert sid is not None +        summary = db.get_today_summary() +        assert len(summary) == 1 +        assert summary[0]['app_name'] == 'Chrome' +        assert summary[0]['total_seconds'] == 60 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_week_summary(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        week = db.get_week_summary() +        assert len(week) >= 1 +        assert week[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_app_rank(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        rank = db.get_app_rank() +        assert len(rank) == 2 +        assert rank[0]['app_name'] == 'VS Code' +        assert rank[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_update_session_end(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        sid = db.insert_session('chrome.exe', 'Google', 'Chrome', now, None, 0) +        assert sid is not None +        new_end = now + timedelta(hours=1) +        db.update_session_end(sid, new_end, 3600) +        cur = db.conn.cursor() +        cur.execute("SELECT end_time, duration_seconds FROM sessions WHERE id=?", (sid,)) +        row = cur.fetchone() +        assert row['end_time'] == new_end.isoformat() +        assert row['duration_seconds'] == 3600 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_get_all_sessions(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        today = datetime.now() +        yesterday = today - timedelta(days=1) +        sid1 = db.insert_session('chrome.exe', 'Google', 'Chrome', yesterday, yesterday, 60) +        sid2 = db.insert_session('code.exe', 'test.py', 'VS Code', today, today, 120) +        assert sid1 is not None +        assert sid2 is not None + +        all_sessions = db.get_all_sessions() +        assert len(all_sessions) == 2 +        assert all_sessions[0]['app_name'] == 'Chrome' +        assert all_sessions[1]['app_name'] == 'VS Code' + +        today_str = today.strftime('%Y-%m-%d') +        filtered = db.get_all_sessions(start_date=today_str, end_date=today_str) +        assert len(filtered) == 1 +        assert filtered[0]['app_name'] == 'VS Code' + +        db.close() +    finally: +        os.unlink(db_path) + + +def test_get_daily_summaries(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        today = datetime.now() +        yesterday = today - timedelta(days=1) +        db.insert_session('chrome.exe', 'Google', 'Chrome', yesterday, yesterday, 60) +        db.insert_session('code.exe', 'test.py', 'VS Code', yesterday, yesterday, 120) +        db.insert_session('code.exe', 'test.py', 'VS Code', today, today, 90) + +        all_summaries = db.get_daily_summaries() +        assert len(all_summaries) == 3 +        assert all_summaries[0]['d'] == yesterday.strftime('%Y-%m-%d') +        assert all_summaries[0]['app_name'] == 'VS Code' +        assert all_summaries[0]['total_seconds'] == 120 +        assert all_summaries[1]['d'] == yesterday.strftime('%Y-%m-%d') +        assert all_summaries[1]['app_name'] == 'Chrome' +        assert all_summaries[1]['total_seconds'] == 60 +        assert all_summaries[2]['d'] == today.strftime('%Y-%m-%d') +        assert all_summaries[2]['app_name'] == 'VS Code' +        assert all_summaries[2]['total_seconds'] == 90 + +        today_str = today.strftime('%Y-%m-%d') +        filtered = db.get_daily_summaries(start_date=today_str, end_date=today_str) +        assert len(filtered) == 1 +        assert filtered[0]['app_name'] == 'VS Code' +        assert filtered[0]['total_seconds'] == 90 + +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_create_table() +    print('test_create_table PASS') +    test_insert_and_query() +    print('test_insert_and_query PASS') +    test_week_summary() +    print('test_week_summary PASS') +    test_app_rank() +    print('test_app_rank PASS') +    test_update_session_end() +    print('test_update_session_end PASS') +    test_get_all_sessions() +    print('test_get_all_sessions PASS') +    test_get_daily_summaries() +    print('test_get_daily_summaries PASS') +    print('All tests passed!') diff --git a/AICOP/Projects/Time Master/tests/test_exporter.py b/AICOP/Projects/Time Master/tests/test_exporter.py new file mode 100644 index 0000000..387ed9f --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_exporter.py	 @@ -0,0 +1,56 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +import csv +from datetime import datetime +from data.database import DatabaseManager +from export.exporter import Exporter + + +def test_export_csv(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'test', 'Chrome', now, now, 60) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.csv') +        exporter.export_csv(out_path) +        with open(out_path, encoding='utf-8-sig') as f: +            reader = csv.reader(f) +            rows = list(reader) +        assert len(rows) == 2 +        assert rows[0] == ['\u8fdb\u7a0b\u540d', '\u7a97\u53e3\u6807\u9898', '\u5e94\u7528\u540d', '\u5f00\u59cb\u65f6\u95f4', '\u7ed3\u675f\u65f6\u95f4', '\u6301\u7eed\u79d2\u6570'] +        assert 'Chrome' in rows[1][2] +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +def test_export_excel(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.xlsx') +        exporter.export_excel(out_path) +        assert os.path.exists(out_path) +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_export_csv() +    print('test_export_csv PASS') +    test_export_excel() +    print('test_export_excel PASS') +    print('All tests passed!') diff --git a/AICOP/Projects/Time Master/tests/test_window_tracker.py b/AICOP/Projects/Time Master/tests/test_window_tracker.py new file mode 100644 index 0000000..0de70d3 --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_window_tracker.py	 @@ -0,0 +1,39 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +from tracker.window_tracker import classify_app + + +def test_classify_known(): +    assert classify_app('chrome.exe') == 'Chrome' +    assert classify_app('Code.exe') == 'VS Code' +    assert classify_app('WeChat.exe') == 'WeChat' +    assert classify_app('OUTLOOK.EXE') == 'Outlook' + + +def test_classify_unknown(): +    result = classify_app('some_random_app.exe') +    assert result == 'some_random_app' + + +def test_classify_case_sensitive(): +    assert classify_app('WINWORD.EXE') == 'Word' +    assert classify_app('winword.exe') == 'Word' + + +def test_classify_no_ext(): +    result = classify_app('myapp.exe') +    assert result == 'myapp' + + +if __name__ == '__main__': +    test_classify_known() +    print('test_classify_known PASS') +    test_classify_unknown() +    print('test_classify_unknown PASS') +    test_classify_case_sensitive() +    print('test_classify_case_sensitive PASS') +    test_classify_no_ext() +    print('test_classify_no_ext PASS') +    print('All tests passed!') diff --git a/AICOP/Projects/Time Master/tracker/__init__.py b/AICOP/Projects/Time Master/tracker/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/tracker/window_tracker.py b/AICOP/Projects/Time Master/tracker/window_tracker.py new file mode 100644 index 0000000..02291ed --- /dev/null +++ b/AICOP/Projects/Time Master/tracker/window_tracker.py	 @@ -0,0 +1,159 @@ +import os +import time +from datetime import datetime + +try: +    from PySide6.QtCore import QThread, Signal +except ImportError: +    QThread = object +    Signal = None + + +APP_NAME_MAP = { +    'chrome.exe': 'Chrome', +    'msedge.exe': 'Edge', +    'firefox.exe': 'Firefox', +    'Code.exe': 'VS Code', +    'WeChat.exe': 'WeChat', +    'WeChatWork.exe': 'WeCom', +    'sublime_text.exe': 'Sublime Text', +    'cmd.exe': 'Command Prompt', +    'WindowsTerminal.exe': 'Terminal', +    'explorer.exe': 'File Explorer', +    'OUTLOOK.EXE': 'Outlook', +    'WINWORD.EXE': 'Word', +    'EXCEL.EXE': 'Excel', +    'POWERPNT.EXE': 'PowerPoint', +    'wmplayer.exe': 'Windows Media Player', +    'Spotify.exe': 'Spotify', +    'Obsidian.exe': 'Obsidian', +    'notepad.exe': 'Notepad', +    'notepad++.exe': 'Notepad++', +    'pycharm64.exe': 'PyCharm', +    'idea64.exe': 'IntelliJ IDEA', +    'clion64.exe': 'CLion', +    'goland64.exe': 'GoLand', +    'devenv.exe': 'Visual Studio', +    'typora.exe': 'Typora', +    'Foxmail.exe': 'Foxmail', +    'DingTalk.exe': 'DingTalk', +    'Lark.exe': 'Lark', +    'Slack.exe': 'Slack', +    'Discord.exe': 'Discord', +    'Telegram.exe': 'Telegram', +    'PotPlayer.exe': 'PotPlayer', +    'eclipse.exe': 'Eclipse', +    'AndroidStudio.exe': 'Android Studio', +    'Tableau.exe': 'Tableau', +    'Figma.exe': 'Figma', +    'Photoshop.exe': 'Photoshop', +    'winword.exe': 'Word', +    'excel.exe': 'Excel', +    'powerpnt.exe': 'PowerPoint', +    'outlook.exe': 'Outlook', +} + + +def classify_app(process_name): +    name = os.path.basename(process_name) +    return APP_NAME_MAP.get(name, os.path.splitext(name)[0]) + + +class WindowTracker(QThread): +    active_window_changed = Signal(str, str, str) if Signal else None +    idle_changed = Signal(bool) if Signal else None + +    POLL_INTERVAL = 1.0 +    IDLE_THRESHOLD = 60 + +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._running = False +        self._current_session_id = None +        self._current_pid = None +        self._current_process = None +        self._current_title = None +        self._current_app = None +        self._session_start = None +        self._idle_seconds = 0 +        self._is_idle = False + +    def stop(self): +        self._running = False + +    def run(self): +        self._running = True +        while self._running: +            try: +                self._tick() +            except Exception: +                pass +            time.sleep(self.POLL_INTERVAL) + +    def _tick(self): +        info = self._get_foreground_window_info() +        now = datetime.now() + +        if info is None: +            self._idle_seconds += self.POLL_INTERVAL +            if self._idle_seconds >= self.IDLE_THRESHOLD and not self._is_idle: +                self._is_idle = True +                self.idle_changed.emit(True) +                self._close_current_session(now) +            return + +        self._idle_seconds = 0 +        if self._is_idle: +            self._is_idle = False +            self.idle_changed.emit(False) + +        pid, process_name, window_title, app_name = info + +        if (pid != self._current_pid or +                window_title != self._current_title): +            self._close_current_session(now) +            self._current_pid = pid +            self._current_process = process_name +            self._current_title = window_title +            self._current_app = app_name +            self._session_start = now +            sid = self.db.insert_session( +                process_name, window_title, app_name, +                now, None, 0 +            ) +            self._current_session_id = sid +            self.active_window_changed.emit(process_name, window_title, app_name) +        else: +            if self._current_session_id is not None and self._session_start is not None: +                duration = int((now - self._session_start).total_seconds()) +                self.db.update_session_end(self._current_session_id, now, duration) + +    def _close_current_session(self, now): +        if self._current_session_id is not None and self._session_start is not None: +            duration = int((now - self._session_start).total_seconds()) +            self.db.update_session_end(self._current_session_id, now, duration) +            self._current_session_id = None +            self._session_start = None + +    def _get_foreground_window_info(self): +        try: +            import win32gui +            import win32process +            import psutil +            hwnd = win32gui.GetForegroundWindow() +            if hwnd == 0: +                return None +            _, pid = win32process.GetWindowThreadProcessId(hwnd) +            try: +                proc = psutil.Process(pid) +                process_name = proc.name() +            except (psutil.NoSuchProcess, psutil.AccessDenied): +                process_name = f'pid_{pid}' +            window_title = win32gui.GetWindowText(hwnd) +            if not window_title: +                window_title = process_name +            app_name = classify_app(process_name) +            return (pid, process_name, window_title, app_name) +        except Exception: +            return None diff --git a/AICOP/Projects/Time Master/ui/__init__.py b/AICOP/Projects/Time Master/ui/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/ui/app_rank_widget.py b/AICOP/Projects/Time Master/ui/app_rank_widget.py new file mode 100644 index 0000000..f728eb6 --- /dev/null +++ b/AICOP/Projects/Time Master/ui/app_rank_widget.py	 @@ -0,0 +1,86 @@ +from PySide6.QtWidgets import QWidget, QVBoxLayout, QLabel, QFrame, QHBoxLayout +from PySide6.QtGui import QPainter, QColor, QPen, QBrush, QFont, QLinearGradient, QPainterPath +from PySide6.QtCore import Qt, QRectF + + +class AppRankItem(QWidget): +    def __init__(self, rank, app_name, total_seconds, max_seconds, parent=None): +        super().__init__(parent) +        self.setFixedHeight(48) +        self.rank = rank +        self.app_name = app_name +        self.total_seconds = total_seconds +        self.max_seconds = max_seconds +        self.setMouseTracking(False) + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) +        w = self.width() +        h = self.height() +        bar_max_w = w - 200 + +        painter.setFont(QFont("PingFang SC", 13, QFont.Normal)) +        painter.setPen(QColor(255, 255, 255, 200)) +        painter.drawText(QRectF(8, 0, 30, h), Qt.AlignLeft | Qt.AlignVCenter, str(self.rank)) + +        painter.setPen(QColor(255, 255, 255, 220)) +        painter.drawText(QRectF(40, 0, 100, h), Qt.AlignLeft | Qt.AlignVCenter, self.app_name) + +        ratio = self.total_seconds / self.max_seconds if self.max_seconds > 0 else 0 +        bar_w = int(bar_max_w * ratio) +        if bar_w > 0: +            gradient = QLinearGradient(0, 0, bar_w, 0) +            gradient.setColorAt(0.0, QColor("#818CF8")) +            gradient.setColorAt(1.0, QColor("#6366F1")) +            painter.setBrush(QBrush(gradient)) +            painter.setPen(Qt.NoPen) +            path = QPainterPath() +            path.addRoundedRect(140, h // 2 - 6, bar_w, 12, 6, 6) +            painter.drawPath(path) + +        mins = self.total_seconds // 60 +        hours = mins // 60 +        remain_mins = mins % 60 +        if hours > 0: +            time_str = f"{hours}h {remain_mins}m" +        else: +            time_str = f"{remain_mins}m" +        painter.setPen(QColor(255, 255, 255, 140)) +        painter.drawText(QRectF(w - 60, 0, 55, h), Qt.AlignRight | Qt.AlignVCenter, time_str) + + +class AppRankWidget(QFrame): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._items = [] +        layout = QVBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(4) + +        title = QLabel("搴旂敤浣跨敤鎺掕 (浠婃棩)") +        title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        title.setStyleSheet("color: rgba(255,255,255,180);") +        layout.addWidget(title) + +        self.list_widget = QWidget() +        self.list_layout = QVBoxLayout(self.list_widget) +        self.list_layout.setContentsMargins(0, 8, 0, 0) +        self.list_layout.setSpacing(2) +        layout.addWidget(self.list_widget) + +    def refresh(self): +        data = self.db.get_app_rank() +        while self.list_layout.count(): +            item = self.list_layout.takeAt(0) +            if item.widget(): +                item.widget().deleteLater() +        max_sec = data[0]['total_seconds'] if data else 1 +        for i, item_data in enumerate(data): +            rank_item = AppRankItem( +                i + 1, item_data['app_name'], +                item_data['total_seconds'], max_sec +            ) +            self.list_layout.addWidget(rank_item) +        self.list_layout.addStretch() diff --git a/AICOP/Projects/Time Master/ui/main_window.py b/AICOP/Projects/Time Master/ui/main_window.py new file mode 100644 index 0000000..47b4bb2 --- /dev/null +++ b/AICOP/Projects/Time Master/ui/main_window.py	 @@ -0,0 +1,120 @@ +import ctypes +from PySide6.QtWidgets import QMainWindow, QVBoxLayout, QWidget, QPushButton, QHBoxLayout, QFileDialog, QMessageBox, QLabel +from PySide6.QtGui import QFont, QColor, QPalette, QBrush, QLinearGradient, QPainter, QAction +from PySide6.QtCore import Qt, QTimer +from ui.stats_widget import StatsWidget +from ui.app_rank_widget import AppRankWidget +from export.exporter import Exporter + + +DWMWA_USE_IMMERSIVE_DARK_MODE = 20 +DWMWA_SYSTEMBACKDROP_TYPE = 38 +MICA = 2 + + +def apply_mica(hwnd): +    try: +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, +            ctypes.byref(ctypes.c_int(1)), ctypes.sizeof(ctypes.c_int) +        ) +        ctypes.windll.dwmapi.DwmSetWindowAttribute( +            hwnd, DWMWA_SYSTEMBACKDROP_TYPE, +            ctypes.byref(ctypes.c_int(MICA)), ctypes.sizeof(ctypes.c_int) +        ) +    except Exception: +        pass + + +class MainWindow(QMainWindow): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self.setWindowTitle("Time Master") +        self.setMinimumSize(800, 500) +        self.resize(900, 600) +        self.setAttribute(Qt.WA_TranslucentBackground) +        self.setStyleSheet(""" +            QMainWindow { background: transparent; } +            QPushButton { +                background-color: rgba(99, 102, 241, 200); +                color: white; +                border: none; +                border-radius: 8px; +                padding: 8px 20px; +                font-family: 'PingFang SC'; +                font-size: 13px; +            } +            QPushButton:hover { +                background-color: rgba(129, 140, 248, 220); +            } +            QPushButton:pressed { +                background-color: rgba(79, 70, 229, 220); +            } +        """) + +        central = QWidget() +        central.setAttribute(Qt.WA_TranslucentBackground) +        self.setCentralWidget(central) +        layout = QVBoxLayout(central) +        layout.setContentsMargins(20, 20, 20, 20) +        layout.setSpacing(16) + +        self.stats_widget = StatsWidget(db) +        layout.addWidget(self.stats_widget) + +        self.app_rank_widget = AppRankWidget(db) +        layout.addWidget(self.app_rank_widget) + +        btn_layout = QHBoxLayout() +        btn_layout.addStretch() +        export_btn = QPushButton("\U0001F4E4 \u5BFC\u51FA\u8BB0\u5F55") +        export_btn.clicked.connect(self._export) +        btn_layout.addWidget(export_btn) +        refresh_btn = QPushButton("\U0001F504 \u5237\u65B0") +        refresh_btn.clicked.connect(self.refresh_data) +        btn_layout.addWidget(refresh_btn) +        layout.addLayout(btn_layout) + +        self.refresh_timer = QTimer(self) +        self.refresh_timer.setInterval(10000) +        self.refresh_timer.timeout.connect(self.refresh_data) +        self.refresh_timer.start() + +    def showEvent(self, event): +        super().showEvent(event) +        QTimer.singleShot(100, self._apply_effect) + +    def _apply_effect(self): +        hwnd = int(self.winId()) +        apply_mica(hwnd) + +    def refresh_data(self): +        self.stats_widget.refresh() +        self.app_rank_widget.refresh() + +    def _export(self): +        from PySide6.QtWidgets import QInputDialog +        formats = ["CSV (.csv)", "Excel (.xlsx)"] +        fmt, ok = QInputDialog.getItem(self, "\u5BFC\u51FA\u683C\u5F0F", "\u9009\u62E9\u5BFC\u51FA\u683C\u5F0F:", formats, 0, False) +        if not ok: +            return +        path, _ = QFileDialog.getSaveFileName( +            self, "\u4FDD\u5B58\u6587\u4EF6", "", +            "CSV \u6587\u4EF6 (*.csv)" if "CSV" in fmt else "Excel \u6587\u4EF6 (*.xlsx)" +        ) +        if not path: +            return +        try: +            exporter = Exporter(self.db) +            if "CSV" in fmt: +                exporter.export_csv(path) +            else: +                exporter.export_excel(path) +            QMessageBox.information(self, "\u5BFC\u51FA\u6210\u529F", "\u8BB0\u5F55\u5DF2\u5BFC\u51FA\u5230:\n" + path) +        except Exception as e: +            QMessageBox.critical(self, "\u5BFC\u51FA\u5931\u8D25", str(e)) + +    def closeEvent(self, event): +        event.ignore() +        self.hide() diff --git a/AICOP/Projects/Time Master/ui/stats_widget.py b/AICOP/Projects/Time Master/ui/stats_widget.py new file mode 100644 index 0000000..7bab054 --- /dev/null +++ b/AICOP/Projects/Time Master/ui/stats_widget.py	 @@ -0,0 +1,181 @@ +from PySide6.QtWidgets import QWidget, QVBoxLayout, QHBoxLayout, QLabel, QFrame +from PySide6.QtGui import QPainter, QColor, QPen, QBrush, QFont, QPainterPath, QLinearGradient +from PySide6.QtCore import Qt, QRectF, Signal, QTimer +from datetime import date, timedelta + + +class CircularProgress(QWidget): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setFixedSize(140, 140) +        self._value = 0 +        self._max_value = 86400 +        self._hours = 0 +        self._minutes = 0 + +    def set_value(self, total_seconds): +        self._value = min(total_seconds, self._max_value) +        total_minutes = total_seconds // 60 +        self._hours = total_minutes // 60 +        self._minutes = total_minutes % 60 +        self.update() + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) + +        rect = QRectF(10, 10, 120, 120) +        pen_width = 10 + +        bg_pen = QPen(QColor(255, 255, 255, 30), pen_width) +        bg_pen.setCapStyle(Qt.RoundCap) +        painter.setPen(bg_pen) +        painter.drawArc(rect, 0, 360 * 16) + +        ratio = self._value / self._max_value +        gradient = QLinearGradient(0, 0, 140, 140) +        gradient.setColorAt(0.0, QColor("#818CF8")) +        gradient.setColorAt(1.0, QColor("#6366F1")) +        fg_pen = QPen(QBrush(gradient), pen_width) +        fg_pen.setCapStyle(Qt.RoundCap) +        painter.setPen(fg_pen) +        span = int(-ratio * 360 * 16) +        painter.drawArc(rect, 90 * 16, span) + +        font_h = QFont("PingFang SC", 32, QFont.Light) +        painter.setFont(font_h) +        painter.setPen(QColor(255, 255, 255)) +        painter.drawText(QRectF(0, 40, 140, 50), Qt.AlignCenter, f"{self._hours}") + +        font_m = QFont("PingFang SC", 14, QFont.Normal) +        painter.setFont(font_m) +        painter.setPen(QColor(255, 255, 255, 180)) +        painter.drawText(QRectF(0, 82, 140, 30), Qt.AlignCenter, f"{self._minutes} 鍒嗛挓") + + +class GlassCard(QFrame): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setStyleSheet(""" +            GlassCard { +                background-color: rgba(255, 255, 255, 8); +                border-radius: 16px; +            } +        """) + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) +        path = QPainterPath() +        path.addRoundedRect(0, 0, self.width(), self.height(), 16, 16) +        gradient = QLinearGradient(0, 0, 0, self.height()) +        gradient.setColorAt(0.0, QColor(255, 255, 255, 25)) +        gradient.setColorAt(1.0, QColor(255, 255, 255, 8)) +        painter.fillPath(path, QBrush(gradient)) +        pen = QPen(QColor(255, 255, 255, 30), 1) +        painter.setPen(pen) +        painter.drawPath(path) + + +class WeeklyBar(QWidget): +    def __init__(self, parent=None): +        super().__init__(parent) +        self.setFixedHeight(120) +        self._data = {} +        self._max_val = 1 + +    def set_data(self, week_data): +        day_names = ['涓€', '浜?, '涓?, '鍥?, '浜?, '鍏?, '鏃?] +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        self._data = {} +        self._max_val = 1 +        for i in range(7): +            d = (monday + timedelta(days=i)).isoformat() +            self._data[d] = 0 +        for item in week_data: +            if item['d'] in self._data: +                self._data[item['d']] = item['total_seconds'] +        self._max_val = max(self._data.values()) if self._data else 1 +        if self._max_val == 0: +            self._max_val = 1 +        self.update() + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) + +        w = self.width() +        h = self.height() +        bar_count = 7 +        bar_w = min(32, (w - 40) // bar_count) +        gap = (w - 40 - bar_w * bar_count) // (bar_count - 1) if bar_count > 1 else 0 +        start_x = 20 +        label_y = h - 20 + +        day_names = ['涓€', '浜?, '涓?, '鍥?, '浜?, '鍏?, '鏃?] +        today = date.today() +        monday = today - timedelta(days=today.weekday()) + +        font_small = QFont("PingFang SC", 11) +        painter.setFont(font_small) + +        for i in range(7): +            x = start_x + i * (bar_w + gap) +            d = (monday + timedelta(days=i)).isoformat() +            val = self._data.get(d, 0) +            bar_h = int((val / self._max_val) * (label_y - 30)) if self._max_val > 0 else 0 +            if bar_h > 0: +                gradient = QLinearGradient(x, label_y - 20 - bar_h, x, label_y - 20) +                gradient.setColorAt(0.0, QColor("#A5B4FC")) +                gradient.setColorAt(1.0, QColor("#6366F1")) +                painter.setBrush(QBrush(gradient)) +                painter.setPen(Qt.NoPen) +                path = QPainterPath() +                path.addRoundedRect(x, label_y - 20 - bar_h, bar_w, bar_h, 4, 4) +                painter.drawPath(path) + +            painter.setPen(QColor(255, 255, 255, 160)) +            painter.drawText(QRectF(x, label_y - 5, bar_w, 20), Qt.AlignCenter, day_names[i]) +            if val > 0: +                mins = val // 60 +                painter.setPen(QColor(255, 255, 255, 100)) +                painter.drawText(QRectF(x, label_y - 28 - bar_h, bar_w, 16), Qt.AlignCenter, f"{mins}m") + + +class StatsWidget(QWidget): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        layout = QHBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(16) + +        today_card = GlassCard(self) +        today_layout = QVBoxLayout(today_card) +        today_layout.setAlignment(Qt.AlignCenter) +        today_title = QLabel("浠婃棩浣跨敤") +        today_title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        today_title.setStyleSheet("color: rgba(255,255,255,180);") +        today_title.setAlignment(Qt.AlignCenter) +        self.circular_progress = CircularProgress() +        today_layout.addWidget(today_title) +        today_layout.addWidget(self.circular_progress, 0, Qt.AlignCenter) +        layout.addWidget(today_card) + +        week_card = GlassCard(self) +        week_layout = QVBoxLayout(week_card) +        week_title = QLabel("鏈懆瓒嬪娍") +        week_title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        week_title.setStyleSheet("color: rgba(255,255,255,180);") +        week_title.setAlignment(Qt.AlignCenter) +        self.weekly_bar = WeeklyBar() +        week_layout.addWidget(week_title) +        week_layout.addWidget(self.weekly_bar) +        layout.addWidget(week_card) + +    def refresh(self): +        total = self.db.get_today_total() +        self.circular_progress.set_value(total) +        week_data = self.db.get_week_summary() +        self.weekly_bar.set_data(week_data) diff --git a/AICOP/Projects/Time Master/ui/tray_manager.py b/AICOP/Projects/Time Master/ui/tray_manager.py new file mode 100644 index 0000000..903fc2f --- /dev/null +++ b/AICOP/Projects/Time Master/ui/tray_manager.py	 @@ -0,0 +1,59 @@ +from PySide6.QtWidgets import QSystemTrayIcon, QMenu +from PySide6.QtGui import QIcon, QAction, QPainter, QPixmap, QColor, QFont, QBrush, QPen +from PySide6.QtCore import Signal, QObject, Qt + + +def create_default_icon(): +    size = 64 +    pixmap = QPixmap(size, size) +    pixmap.fill(Qt.transparent) +    painter = QPainter(pixmap) +    painter.setRenderHint(QPainter.Antialiasing) +    painter.setBrush(QBrush(QColor("#6366F1"))) +    painter.setPen(QPen(QColor("#6366F1"), 0)) +    painter.drawRoundedRect(4, 4, size - 8, size - 8, 12, 12) +    painter.setPen(QColor("white")) +    font = QFont("PingFang SC", 28, QFont.Bold) +    painter.setFont(font) +    painter.drawText(pixmap.rect(), Qt.AlignCenter, "T") +    painter.end() +    return QIcon(pixmap) + + +class TrayManager(QObject): +    show_main_window = Signal() +    quit_app = Signal() + +    def __init__(self, app_name="Time Master", parent=None): +        super().__init__(parent) +        self.app_name = app_name +        self.tray = QSystemTrayIcon(self) +        self.tray.setIcon(create_default_icon()) +        self.tray.setToolTip(app_name) + +        menu = QMenu() +        show_action = QAction("鏄剧ず涓荤晫闈?, self) +        show_action.triggered.connect(self.show_main_window.emit) +        menu.addAction(show_action) + +        menu.addSeparator() + +        quit_action = QAction("閫€鍑?, self) +        quit_action.triggered.connect(self.quit_app.emit) +        menu.addAction(quit_action) + +        self.tray.setContextMenu(menu) +        self.tray.activated.connect(self._on_activated) + +    def _on_activated(self, reason): +        if reason == QSystemTrayIcon.ActivationReason.DoubleClick: +            self.show_main_window.emit() + +    def set_tooltip(self, text): +        self.tray.setToolTip(text) + +    def show_notification(self, title, message): +        self.tray.showMessage(title, message, QIcon(), 3000) + +    def show(self): +        self.tray.show()
