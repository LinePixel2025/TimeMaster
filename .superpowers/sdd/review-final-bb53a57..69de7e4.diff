 @@ -0,0 +1,56 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +import csv +from datetime import datetime +from data.database import DatabaseManager +from export.exporter import Exporter + + +def test_export_csv(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'test', 'Chrome', now, now, 60) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.csv') +        exporter.export_csv(out_path) +        with open(out_path, encoding='utf-8-sig') as f: +            reader = csv.reader(f) +            rows = list(reader) +        assert len(rows) == 2 +        assert rows[0] == ['\u8fdb\u7a0b\u540d', '\u7a97\u53e3\u6807\u9898', '\u5e94\u7528\u540d', '\u5f00\u59cb\u65f6\u95f4', '\u7ed3\u675f\u65f6\u95f4', '\u6301\u7eed\u79d2\u6570'] +        assert 'Chrome' in rows[1][2] +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +def test_export_excel(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        exporter = Exporter(db) +        out_path = os.path.join(tempfile.gettempdir(), 'test_export.xlsx') +        exporter.export_excel(out_path) +        assert os.path.exists(out_path) +        os.unlink(out_path) +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_export_csv() +    print('test_export_csv PASS') +    test_export_excel() +    print('test_export_excel PASS') +    print('All tests passed!') diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/review-b4b86f5..0a3ae97.diff b/AICOP/Projects/Time Master/.superpowers/sdd/review-b4b86f5..0a3ae97.diff new file mode 100644 index 0000000..f101ab3 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/review-b4b86f5..0a3ae97.diff	 @@ -0,0 +1,7 @@ +锘? Review package: b4b86f5..0a3ae97 +## Commits +0a3ae97 feat: add app usage ranking list with progress bars +## Files changed + AICOP/Projects/Time Master/ui/app_rank_widget.py | 86 ++++++++++++++++++++++++  1 file changed, 86 insertions(+) +## Diff +diff --git a/AICOP/Projects/Time Master/ui/app_rank_widget.py b/AICOP/Projects/Time Master/ui/app_rank_widget.py new file mode 100644 index 0000000..f728eb6 --- /dev/null +++ b/AICOP/Projects/Time Master/ui/app_rank_widget.py	 @@ -0,0 +1,86 @@ +from PySide6.QtWidgets import QWidget, QVBoxLayout, QLabel, QFrame, QHBoxLayout +from PySide6.QtGui import QPainter, QColor, QPen, QBrush, QFont, QLinearGradient, QPainterPath +from PySide6.QtCore import Qt, QRectF + + +class AppRankItem(QWidget): +    def __init__(self, rank, app_name, total_seconds, max_seconds, parent=None): +        super().__init__(parent) +        self.setFixedHeight(48) +        self.rank = rank +        self.app_name = app_name +        self.total_seconds = total_seconds +        self.max_seconds = max_seconds +        self.setMouseTracking(False) + +    def paintEvent(self, event): +        painter = QPainter(self) +        painter.setRenderHint(QPainter.Antialiasing) +        w = self.width() +        h = self.height() +        bar_max_w = w - 200 + +        painter.setFont(QFont("PingFang SC", 13, QFont.Normal)) +        painter.setPen(QColor(255, 255, 255, 200)) +        painter.drawText(QRectF(8, 0, 30, h), Qt.AlignLeft | Qt.AlignVCenter, str(self.rank)) + +        painter.setPen(QColor(255, 255, 255, 220)) +        painter.drawText(QRectF(40, 0, 100, h), Qt.AlignLeft | Qt.AlignVCenter, self.app_name) + +        ratio = self.total_seconds / self.max_seconds if self.max_seconds > 0 else 0 +        bar_w = int(bar_max_w * ratio) +        if bar_w > 0: +            gradient = QLinearGradient(0, 0, bar_w, 0) +            gradient.setColorAt(0.0, QColor("#818CF8")) +            gradient.setColorAt(1.0, QColor("#6366F1")) +            painter.setBrush(QBrush(gradient)) +            painter.setPen(Qt.NoPen) +            path = QPainterPath() +            path.addRoundedRect(140, h // 2 - 6, bar_w, 12, 6, 6) +            painter.drawPath(path) + +        mins = self.total_seconds // 60 +        hours = mins // 60 +        remain_mins = mins % 60 +        if hours > 0: +            time_str = f"{hours}h {remain_mins}m" +        else: +            time_str = f"{remain_mins}m" +        painter.setPen(QColor(255, 255, 255, 140)) +        painter.drawText(QRectF(w - 60, 0, 55, h), Qt.AlignRight | Qt.AlignVCenter, time_str) + + +class AppRankWidget(QFrame): +    def __init__(self, db, parent=None): +        super().__init__(parent) +        self.db = db +        self._items = [] +        layout = QVBoxLayout(self) +        layout.setContentsMargins(16, 16, 16, 16) +        layout.setSpacing(4) + +        title = QLabel("鎼存梻鏁ゆ担璺ㄦ暏閹烘帟顢?(娴犲﹥妫?") +        title.setFont(QFont("PingFang SC", 14, QFont.Normal)) +        title.setStyleSheet("color: rgba(255,255,255,180);") +        layout.addWidget(title) + +        self.list_widget = QWidget() +        self.list_layout = QVBoxLayout(self.list_widget) +        self.list_layout.setContentsMargins(0, 8, 0, 0) +        self.list_layout.setSpacing(2) +        layout.addWidget(self.list_widget) + +    def refresh(self): +        data = self.db.get_app_rank() +        while self.list_layout.count(): +            item = self.list_layout.takeAt(0) +            if item.widget(): +                item.widget().deleteLater() +        max_sec = data[0]['total_seconds'] if data else 1 +        for i, item_data in enumerate(data): +            rank_item = AppRankItem( +                i + 1, item_data['app_name'], +                item_data['total_seconds'], max_sec +            ) +            self.list_layout.addWidget(rank_item) +        self.list_layout.addStretch() diff --git a/AICOP/Projects/Time Master/.superpowers/sdd/review-bb53a57..66d8799.diff b/AICOP/Projects/Time Master/.superpowers/sdd/review-bb53a57..66d8799.diff new file mode 100644 index 0000000..ef73d15 --- /dev/null +++ b/AICOP/Projects/Time Master/.superpowers/sdd/review-bb53a57..66d8799.diff	 @@ -0,0 +1,10 @@ +锘? Review package: bb53a57..66d8799 + +## Commits +66d8799 feat: add database layer with SQLite schema and CRUD operations + +## Files changed + AICOP/Projects/Time Master/.gitignore             |   7 ++  AICOP/Projects/Time Master/data/__init__.py       |   0  AICOP/Projects/Time Master/data/database.py       | 143 ++++++++++++++++++++++  AICOP/Projects/Time Master/requirements.txt       |   5 +  AICOP/Projects/Time Master/tests/__init__.py      |   0  AICOP/Projects/Time Master/tests/test_database.py |  83 +++++++++++++  6 files changed, 238 insertions(+) + +## Diff +diff --git a/AICOP/Projects/Time Master/.gitignore b/AICOP/Projects/Time Master/.gitignore new file mode 100644 index 0000000..066fc96 --- /dev/null +++ b/AICOP/Projects/Time Master/.gitignore	 @@ -0,0 +1,7 @@ +__pycache__/ +*.pyc +*.pyo +*.db +*.db-journal +*.db-wal +*.db-shm diff --git a/AICOP/Projects/Time Master/data/__init__.py b/AICOP/Projects/Time Master/data/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/data/database.py b/AICOP/Projects/Time Master/data/database.py new file mode 100644 index 0000000..5cdf281 --- /dev/null +++ b/AICOP/Projects/Time Master/data/database.py	 @@ -0,0 +1,143 @@ +import sqlite3 +import os +from datetime import datetime, date, timedelta + + +class DatabaseManager: +    def __init__(self, db_path=None): +        if db_path is None: +            appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +            db_dir = os.path.join(appdata, 'Time Master') +            os.makedirs(db_dir, exist_ok=True) +            db_path = os.path.join(db_dir, 'data.db') +        self.conn = sqlite3.connect(db_path, check_same_thread=False) +        self.conn.row_factory = sqlite3.Row +        self._migrate() + +    def _migrate(self): +        cur = self.conn.cursor() +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS sessions ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                process_name TEXT NOT NULL, +                window_title TEXT NOT NULL DEFAULT '', +                app_name TEXT NOT NULL, +                start_time TEXT NOT NULL, +                end_time TEXT, +                duration_seconds INTEGER DEFAULT 0 +            ) +        ''') +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS daily_summary ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                date TEXT NOT NULL, +                app_name TEXT NOT NULL, +                total_seconds INTEGER DEFAULT 0, +                UNIQUE(date, app_name) +            ) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_start ON sessions(start_time) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_app ON sessions(app_name) +        ''') +        self.conn.commit() + +    def insert_session(self, process_name, window_title, app_name, start_time, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            INSERT INTO sessions (process_name, window_title, app_name, start_time, end_time, duration_seconds) +            VALUES (?, ?, ?, ?, ?, ?) +        ''', (process_name, window_title, app_name, start_time.isoformat(), end_time.isoformat() if end_time else None, duration_seconds)) +        self.conn.commit() +        return cur.lastrowid + +    def update_session_end(self, session_id, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            UPDATE sessions SET end_time=?, duration_seconds=? WHERE id=? +        ''', (end_time.isoformat(), duration_seconds, session_id)) +        self.conn.commit() + +    def get_today_summary(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (today_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_today_total(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT COALESCE(SUM(duration_seconds), 0) as total +            FROM sessions WHERE date(start_time) = ? +        ''', (today_str,)) +        row = cur.fetchone() +        return row['total'] if row else 0 + +    def get_week_summary(self): +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT date(start_time) as d, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) >= ? AND date(start_time) <= ? +            GROUP BY date(start_time) +            ORDER BY d ASC +        ''', (monday.isoformat(), today.isoformat())) +        return [dict(r) for r in cur.fetchall()] + +    def get_app_rank(self, target_date=None): +        if target_date is None: +            target_date = date.today() +        date_str = target_date.isoformat() if isinstance(target_date, date) else target_date +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (date_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_all_sessions(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT * FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                ORDER BY start_time ASC +            ''', (start_date, end_date)) +        else: +            cur.execute('SELECT * FROM sessions ORDER BY start_time ASC') +        return [dict(r) for r in cur.fetchall()] + +    def get_daily_summaries(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''', (start_date, end_date)) +        else: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''') +        return [dict(r) for r in cur.fetchall()] + +    def close(self): +        self.conn.close() diff --git a/AICOP/Projects/Time Master/requirements.txt b/AICOP/Projects/Time Master/requirements.txt new file mode 100644 index 0000000..509e63b --- /dev/null +++ b/AICOP/Projects/Time Master/requirements.txt	 @@ -0,0 +1,5 @@ +PySide6>=6.6.0 +pywin32>=306 +psutil>=5.9.0 +openpyxl>=3.1.0 +pyqtgraph>=0.13.0 diff --git a/AICOP/Projects/Time Master/tests/__init__.py b/AICOP/Projects/Time Master/tests/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/tests/test_database.py b/AICOP/Projects/Time Master/tests/test_database.py new file mode 100644 index 0000000..211d78c --- /dev/null +++ b/AICOP/Projects/Time Master