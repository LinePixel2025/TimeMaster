xab\xe6\xa4\x82\xe9\x97\x82?', +        b'\xe7\xbc\x81\xe6\x92\xb4\xe6\xbd\xab\xe9\x8f\x83\xe5\xa0\x95\xe6\xa3\xbf', +        b'\xe9\x8e\xb8\xe4\xbd\xba\xe7\x94\xbb\xe7\xbb\x89\xe6\x8e\x93\xe6\x9a\x9f', +    ] +    return [h.decode('utf-8') for h in headers] + + +def make_escaped(headers): +    """Return a Python-source-string representation using \\u escapes for unprintables.""" +    parts = [] +    for h in headers: +        escaped = '' +        for ch in h: +            cp = ord(ch) +            if cp > 127: +                escaped += f'\\u{cp:04x}' +            else: +                escaped += ch +        parts.append(f"'{escaped}'") +    return '[' + ', '.join(parts) + ']' + + +headers = make_header_list() +escaped_list = make_escaped(headers) +print('Header escaped list:', escaped_list) + +# Verify roundtrip +import ast +reparsed = ast.literal_eval(escaped_list) +assert reparsed == headers, f'Mismatch: {reparsed} != {headers}' +print('Roundtrip OK') + +# Build exporter.py content +exporter_content = '''import csv +from datetime import date, timedelta + + +class Exporter: +    def __init__(self, db): +        self.db = db + +    def export_csv(self, path): +        sessions = self.db.get_all_sessions() +        with open(path, 'w', newline='', encoding='utf-8-sig') as f: +            writer = csv.writer(f) +            writer.writerow({headers_list}) +            for s in sessions: +                writer.writerow([ +                    s['process_name'], s['window_title'], s['app_name'], +                    s['start_time'], s['end_time'], s['duration_seconds'] +                ]) + +    def export_excel(self, path): +        from openpyxl import Workbook +        from openpyxl.styles import Font, Alignment + +        wb = Workbook() + +        ws1 = wb.active +        ws1.title = {sheet1_title!r} +        ws1.append({headers_list}) +        for cell in ws1[1]: +            cell.font = Font(bold=True) +        sessions = self.db.get_all_sessions() +        for s in sessions: +            ws1.append([s['process_name'], s['window_title'], s['app_name'], +                        s['start_time'], s['end_time'], s['duration_seconds']]) +        for col in ws1.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws1.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        today = date.today() +        monday = today - timedelta(days=today.weekday()) + +        ws2 = wb.create_sheet({sheet2_title!r}) +        ws2.append({daily_headers_list}) +        for cell in ws2[1]: +            cell.font = Font(bold=True) +        summaries = self.db.get_daily_summaries( +            monday.isoformat(), today.isoformat() +        ) +        for s in summaries: +            ws2.append([s['d'], s['app_name'], s['total_seconds']]) +        for col in ws2.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws2.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        ws3 = wb.create_sheet({sheet3_title!r}) +        ws3.append({rank_headers_list}) +        for cell in ws3[1]: +            cell.font = Font(bold=True) +        rank = self.db.get_app_rank() +        for r in rank: +            ws3.append([r['app_name'], r['total_seconds']]) +        for col in ws3.columns: +            max_len = max((len(str(cell.value or '')) for cell in col), default=0) +            ws3.column_dimensions[col[0].column_letter].width = min(max_len + 4, 40) + +        wb.save(path) +'''.format( +    headers_list=escaped_list, +    sheet1_title=headers[0].split('?')[0][:2] + '?', +    daily_headers_list=make_escaped(make_header_list()[0:1] + [headers[2].split('?')[0] + '??']), +    rank_headers_list=make_escaped([headers[2].split('?')[0] + '??', headers[5].split('?')[0] + '??']), +    sheet2_title=headers[2].split('?')[0][:1] + '???', +    sheet3_title=headers[2].split('?')[0][:2] + '???', +) + +print() +print(exporter_content) diff --git a/AICOP/Projects/Time Master/data/__init__.py b/AICOP/Projects/Time Master/data/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/data/database.py b/AICOP/Projects/Time Master/data/database.py new file mode 100644 index 0000000..5cdf281 --- /dev/null +++ b/AICOP/Projects/Time Master/data/database.py	 @@ -0,0 +1,143 @@ +import sqlite3 +import os +from datetime import datetime, date, timedelta + + +class DatabaseManager: +    def __init__(self, db_path=None): +        if db_path is None: +            appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +            db_dir = os.path.join(appdata, 'Time Master') +            os.makedirs(db_dir, exist_ok=True) +            db_path = os.path.join(db_dir, 'data.db') +        self.conn = sqlite3.connect(db_path, check_same_thread=False) +        self.conn.row_factory = sqlite3.Row +        self._migrate() + +    def _migrate(self): +        cur = self.conn.cursor() +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS sessions ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                process_name TEXT NOT NULL, +                window_title TEXT NOT NULL DEFAULT '', +                app_name TEXT NOT NULL, +                start_time TEXT NOT NULL, +                end_time TEXT, +                duration_seconds INTEGER DEFAULT 0 +            ) +        ''') +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS daily_summary ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                date TEXT NOT NULL, +                app_name TEXT NOT NULL, +                total_seconds INTEGER DEFAULT 0, +                UNIQUE(date, app_name) +            ) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_start ON sessions(start_time) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_app ON sessions(app_name) +        ''') +        self.conn.commit() + +    def insert_session(self, process_name, window_title, app_name, start_time, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            INSERT INTO sessions (process_name, window_title, app_name, start_time, end_time, duration_seconds) +            VALUES (?, ?, ?, ?, ?, ?) +        ''', (process_name, window_title, app_name, start_time.isoformat(), end_time.isoformat() if end_time else None, duration_seconds)) +        self.conn.commit() +        return cur.lastrowid + +    def update_session_end(self, session_id, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            UPDATE sessions SET end_time=?, duration_seconds=? WHERE id=? +        ''', (end_time.isoformat(), duration_seconds, session_id)) +        self.conn.commit() + +    def get_today_summary(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (today_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_today_total(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT COALESCE(SUM(duration_seconds), 0) as total +            FROM sessions WHERE date(start_time) = ? +        ''', (today_str,)) +        row = cur.fetchone() +        return row['total'] if row else 0 + +    def get_week_summary(self): +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT date(start_time) as d, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) >= ? AND date(start_time) <= ? +            GROUP BY date(start_time) +            ORDER BY d ASC +        ''', (monday.isoformat(), today.isoformat())) +        return [dict(r) for r in cur.fetchall()] + +    def get_app_rank(self, target_date=None): +        if target_date is None: +            target_date = date.today() +        date_str = target_date.isoformat() if isinstance(target_date, date) else target_date +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (date_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_all_sessions(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT * FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                ORDER BY start_time ASC +            ''', (start_date, end_date)) +        else: +            cur.execute('SELECT * FROM sessions ORDER BY start_time ASC') +        return [dict(r) for r in cur.fetchall()] + +    def get_daily_summaries(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''', (start_date, end_date)) +        else: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''') +   