diff --git a/AICOP/Projects/Time Master/.gitignore b/AICOP/Projects/Time Master/.gitignore new file mode 100644 index 0000000..066fc96 --- /dev/null +++ b/AICOP/Projects/Time Master/.gitignore	 @@ -0,0 +1,7 @@ +__pycache__/ +*.pyc +*.pyo +*.db +*.db-journal +*.db-wal +*.db-shm diff --git a/AICOP/Projects/Time Master/data/__init__.py b/AICOP/Projects/Time Master/data/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/data/database.py b/AICOP/Projects/Time Master/data/database.py new file mode 100644 index 0000000..5cdf281 --- /dev/null +++ b/AICOP/Projects/Time Master/data/database.py	 @@ -0,0 +1,143 @@ +import sqlite3 +import os +from datetime import datetime, date, timedelta + + +class DatabaseManager: +    def __init__(self, db_path=None): +        if db_path is None: +            appdata = os.environ.get('APPDATA', os.path.expanduser('~')) +            db_dir = os.path.join(appdata, 'Time Master') +            os.makedirs(db_dir, exist_ok=True) +            db_path = os.path.join(db_dir, 'data.db') +        self.conn = sqlite3.connect(db_path, check_same_thread=False) +        self.conn.row_factory = sqlite3.Row +        self._migrate() + +    def _migrate(self): +        cur = self.conn.cursor() +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS sessions ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                process_name TEXT NOT NULL, +                window_title TEXT NOT NULL DEFAULT '', +                app_name TEXT NOT NULL, +                start_time TEXT NOT NULL, +                end_time TEXT, +                duration_seconds INTEGER DEFAULT 0 +            ) +        ''') +        cur.execute(''' +            CREATE TABLE IF NOT EXISTS daily_summary ( +                id INTEGER PRIMARY KEY AUTOINCREMENT, +                date TEXT NOT NULL, +                app_name TEXT NOT NULL, +                total_seconds INTEGER DEFAULT 0, +                UNIQUE(date, app_name) +            ) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_start ON sessions(start_time) +        ''') +        cur.execute(''' +            CREATE INDEX IF NOT EXISTS idx_sessions_app ON sessions(app_name) +        ''') +        self.conn.commit() + +    def insert_session(self, process_name, window_title, app_name, start_time, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            INSERT INTO sessions (process_name, window_title, app_name, start_time, end_time, duration_seconds) +            VALUES (?, ?, ?, ?, ?, ?) +        ''', (process_name, window_title, app_name, start_time.isoformat(), end_time.isoformat() if end_time else None, duration_seconds)) +        self.conn.commit() +        return cur.lastrowid + +    def update_session_end(self, session_id, end_time, duration_seconds): +        cur = self.conn.cursor() +        cur.execute(''' +            UPDATE sessions SET end_time=?, duration_seconds=? WHERE id=? +        ''', (end_time.isoformat(), duration_seconds, session_id)) +        self.conn.commit() + +    def get_today_summary(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (today_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_today_total(self): +        today_str = date.today().isoformat() +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT COALESCE(SUM(duration_seconds), 0) as total +            FROM sessions WHERE date(start_time) = ? +        ''', (today_str,)) +        row = cur.fetchone() +        return row['total'] if row else 0 + +    def get_week_summary(self): +        today = date.today() +        monday = today - timedelta(days=today.weekday()) +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT date(start_time) as d, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) >= ? AND date(start_time) <= ? +            GROUP BY date(start_time) +            ORDER BY d ASC +        ''', (monday.isoformat(), today.isoformat())) +        return [dict(r) for r in cur.fetchall()] + +    def get_app_rank(self, target_date=None): +        if target_date is None: +            target_date = date.today() +        date_str = target_date.isoformat() if isinstance(target_date, date) else target_date +        cur = self.conn.cursor() +        cur.execute(''' +            SELECT app_name, SUM(duration_seconds) as total_seconds +            FROM sessions +            WHERE date(start_time) = ? +            GROUP BY app_name +            ORDER BY total_seconds DESC +        ''', (date_str,)) +        return [dict(r) for r in cur.fetchall()] + +    def get_all_sessions(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT * FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                ORDER BY start_time ASC +            ''', (start_date, end_date)) +        else: +            cur.execute('SELECT * FROM sessions ORDER BY start_time ASC') +        return [dict(r) for r in cur.fetchall()] + +    def get_daily_summaries(self, start_date=None, end_date=None): +        cur = self.conn.cursor() +        if start_date and end_date: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions +                WHERE date(start_time) >= ? AND date(start_time) <= ? +                GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''', (start_date, end_date)) +        else: +            cur.execute(''' +                SELECT date(start_time) as d, app_name, SUM(duration_seconds) as total_seconds +                FROM sessions GROUP BY d, app_name +                ORDER BY d ASC, total_seconds DESC +            ''') +        return [dict(r) for r in cur.fetchall()] + +    def close(self): +        self.conn.close() diff --git a/AICOP/Projects/Time Master/requirements.txt b/AICOP/Projects/Time Master/requirements.txt new file mode 100644 index 0000000..509e63b --- /dev/null +++ b/AICOP/Projects/Time Master/requirements.txt	 @@ -0,0 +1,5 @@ +PySide6>=6.6.0 +pywin32>=306 +psutil>=5.9.0 +openpyxl>=3.1.0 +pyqtgraph>=0.13.0 diff --git a/AICOP/Projects/Time Master/tests/__init__.py b/AICOP/Projects/Time Master/tests/__init__.py new file mode 100644 index 0000000..e69de29 diff --git a/AICOP/Projects/Time Master/tests/test_database.py b/AICOP/Projects/Time Master/tests/test_database.py new file mode 100644 index 0000000..211d78c --- /dev/null +++ b/AICOP/Projects/Time Master/tests/test_database.py	 @@ -0,0 +1,83 @@ +import sys +import os +sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..')) + +import tempfile +from datetime import datetime, date, timedelta +from data.database import DatabaseManager + + +def test_create_table(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        cur = db.conn.cursor() +        cur.execute("SELECT name FROM sqlite_master WHERE type='table'") +        tables = [r['name'] for r in cur.fetchall()] +        assert 'sessions' in tables +        assert 'daily_summary' in tables +        db.close() +    finally: +        os.unlink(db_path) + + +def test_insert_and_query(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        sid = db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        assert sid is not None +        summary = db.get_today_summary() +        assert len(summary) == 1 +        assert summary[0]['app_name'] == 'Chrome' +        assert summary[0]['total_seconds'] == 60 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_week_summary(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        week = db.get_week_summary() +        assert len(week) >= 1 +        assert week[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +def test_app_rank(): +    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f: +        db_path = f.name +    try: +        db = DatabaseManager(db_path) +        now = datetime.now() +        db.insert_session('chrome.exe', 'Google', 'Chrome', now, now, 60) +        db.insert_session('Code.exe', 'test.py', 'VS Code', now, now, 120) +        rank = db.get_app_rank() +        assert len(rank) == 2 +        assert rank[0]['app_name'] == 'VS Code' +        assert rank[0]['total_seconds'] == 120 +        db.close() +    finally: +        os.unlink(db_path) + + +if __name__ == '__main__': +    test_create_table() +    print('test_create_table PASS') +    test_insert_and_query() +    print('test_insert_and_query PASS') +    test_week_summary() +    print('test_week_summary PASS') +    test_app_rank() +    print('test_app_rank PASS') +    print('All tests passed!')
