     QSqlQuery q(m_db);
     q.prepare("SELECT COALESCE(SUM(duration_seconds), 0) as total "
               "FROM sessions WHERE date(start_time) = ?");
     q.addBindValue(QDate::currentDate().toString(Qt::ISODate));
